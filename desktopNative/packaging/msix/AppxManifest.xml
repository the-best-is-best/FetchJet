<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
    xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
    IgnorableNamespaces="uap uap3 uap5 desktop rescap">

    <Identity Name="MichelleRaouf.FetchJet" ProcessorArchitecture="x64"
        Publisher="CN=81BF98FB-E3BB-479B-BCA6-3F56A36736A0" Version="__VERSION__" />

    <Properties>
        <DisplayName>FetchJet</DisplayName>
        <PublisherDisplayName>Michelle Raouf</PublisherDisplayName>
        <Logo>Assets\StoreLogo.png</Logo>
    </Properties>

    <Dependencies>
        <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    </Dependencies>

    <Resources>
        <Resource Language="en-us" />
        <Resource Language="ar" />
        <Resource Language="fr" />
        <Resource Language="de" />
        <Resource Language="es" />
        <Resource Language="pt" />
        <Resource Language="it" />
        <Resource Language="ru" />
        <Resource Language="tr" />
        <Resource Language="id" />
        <Resource Language="zh-cn" />
        <Resource Language="ja" />
        <Resource Language="ko" />
        <Resource Language="hi" />
        <Resource Language="fa" />
    </Resources>

    <Applications>
        <Application Id="FetchJet" Executable="FetchJet.exe" EntryPoint="Windows.FullTrustApplication">
            <uap:VisualElements DisplayName="FetchJet"
                Description="Download manager for files, videos, playlists and torrents"
                BackgroundColor="transparent"
                Square150x150Logo="Assets\Square150x150Logo.png"
                Square44x44Logo="Assets\Square44x44Logo.png">
                <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
            </uap:VisualElements>
            <Extensions>
                <uap:Extension Category="windows.fileTypeAssociation">
                    <uap:FileTypeAssociation Name="torrent">
                        <uap:DisplayName>BitTorrent file</uap:DisplayName>
                        <uap:SupportedFileTypes>
                            <uap:FileType ContentType="application/x-bittorrent">.torrent</uap:FileType>
                        </uap:SupportedFileTypes>
                    </uap:FileTypeAssociation>
                </uap:Extension>
                <uap:Extension Category="windows.protocol">
                    <uap:Protocol Name="fetchjet">
                        <uap:DisplayName>FetchJet link</uap:DisplayName>
                    </uap:Protocol>
                </uap:Extension>
                <uap:Extension Category="windows.protocol">
                    <uap:Protocol Name="magnet">
                        <uap:DisplayName>Magnet link</uap:DisplayName>
                    </uap:Protocol>
                </uap:Extension>
                <desktop:Extension Category="windows.startupTask" Executable="FetchJet.exe" EntryPoint="Windows.FullTrustApplication">
                    <desktop:StartupTask TaskId="FetchJetStartup" Enabled="true" DisplayName="FetchJet" />
                </desktop:Extension>
                <uap3:Extension Category="windows.appExecutionAlias" Executable="FetchJet.exe" EntryPoint="Windows.FullTrustApplication">
                    <uap3:AppExecutionAlias>
                        <desktop:ExecutionAlias Alias="fetchjet.exe" />
                    </uap3:AppExecutionAlias>
                </uap3:Extension>
            </Extensions>
        </Application>
    </Applications>

    <Capabilities>
        <Capability Name="internetClient" />
        <Capability Name="internetClientServer" />
        <Capability Name="privateNetworkClientServer" />
        <rescap:Capability Name="runFullTrust" />
    </Capabilities>
</Package>
