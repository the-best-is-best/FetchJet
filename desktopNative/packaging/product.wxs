<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="FetchJet"
           Manufacturer="Michelle Raouf"
           Language="1033"
           Codepage="1252"
           Version="$(var.Version)"
           UpgradeCode="{7E1C3F2A-5B7D-4C8E-9A61-4F2A9C1B7D30}">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Platform="x64"
             Description="FetchJet High-Velocity Multi-Engine Downloader"
             Manufacturer="Michelle Raouf"
             Languages="1033"
             SummaryCodepage="1252" />

    <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallValidate" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FetchJetIcon.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="FetchJetIcon.ico" />
    <Property Id="ARPCOMMENTS" Value="FetchJet High-Velocity Multi-Engine Downloader" />
    <Property Id="ARPCONTACT" Value="Michelle Raouf" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize" />

    <Property Id="JP_INSTALL_DESKTOP_SHORTCUT" Value="1" />
    <Property Id="JP_INSTALL_STARTMENU_SHORTCUT" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLDIR" Name="FetchJet" />
      </Directory>
      <Directory Id="DesktopFolder" />
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="FetchJet" />
      </Directory>
    </Directory>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{4B0F2E61-8C3A-4D57-9E1B-2A6C7D8E9F01}">
        <Condition>JP_INSTALL_DESKTOP_SHORTCUT</Condition>
        <Shortcut Id="DesktopShortcutLink"
                  Name="FetchJet"
                  Description="FetchJet High-Velocity Multi-Engine Downloader"
                  Target="[INSTALLDIR]FetchJet.exe"
                  WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKCU" Key="Software\Michelle Raouf\FetchJet" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="StartMenuShortcut" Guid="{5C1A3F72-9D4B-4E68-8F2C-3B7D8E9FA012}">
        <Condition>JP_INSTALL_STARTMENU_SHORTCUT</Condition>
        <Shortcut Id="StartMenuShortcutLink"
                  Name="FetchJet"
                  Description="FetchJet High-Velocity Multi-Engine Downloader"
                  Target="[INSTALLDIR]FetchJet.exe"
                  WorkingDirectory="INSTALLDIR" />
        <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Michelle Raouf\FetchJet" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="TorrentFileType" Guid="{6D2B4A83-AE5C-4F79-902D-4C8E9FA0B123}">
        <RegistryValue Root="HKCU" Key="Software\Classes\.torrent" Type="string" Value="progidb6b76d118e2c3f3e9f64d373ac4670d0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.torrent" Name="Content Type" Type="string" Value="application/x-bittorrent" />
        <RegistryValue Root="HKCU" Key="Software\Classes\progidb6b76d118e2c3f3e9f64d373ac4670d0" Type="string" Value="BitTorrent file" />
        <RegistryValue Root="HKCU" Key="Software\Classes\progidb6b76d118e2c3f3e9f64d373ac4670d0\DefaultIcon" Type="string" Value="&quot;[INSTALLDIR]FetchJet.exe&quot;,0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\progidb6b76d118e2c3f3e9f64d373ac4670d0\shell\open" Type="string" Value="Open with [ProductName]" />
        <RegistryValue Root="HKCU" Key="Software\Classes\progidb6b76d118e2c3f3e9f64d373ac4670d0\shell\open\command" Type="string" Value="&quot;[INSTALLDIR]FetchJet.exe&quot; &quot;%1&quot; %*" />
        <RegistryValue Root="HKCU" Key="Software\Classes\MIME\Database\Content Type\application/x-bittorrent" Name="Extension" Type="string" Value=".torrent" />
        <RegistryValue Root="HKCU" Key="Software\Michelle Raouf\FetchJet" Name="TorrentFileType" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="FetchJet" Level="1" Absent="disallow" AllowAdvertise="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="TorrentFileType" />
    </Feature>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">1</Publish>
    </UI>
  </Product>
</Wix>
