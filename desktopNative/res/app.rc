#include <winver.h>
#include "fj_version.h"

1 ICON "fetchjet.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION FJ_VERSION_MAJOR, FJ_VERSION_MINOR, FJ_VERSION_PATCH, 0
PRODUCTVERSION FJ_VERSION_MAJOR, FJ_VERSION_MINOR, FJ_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Michelle Raouf"
            VALUE "FileDescription", "FetchJet High-Velocity Multi-Engine Downloader"
            VALUE "FileVersion", FJ_VERSION_TEXT
            VALUE "InternalName", "FetchJet.exe"
            VALUE "LegalCopyright", FJ_VERSION_COPYRIGHT
            VALUE "OriginalFilename", "FetchJet.exe"
            VALUE "ProductName", "FetchJet"
            VALUE "ProductVersion", FJ_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
