export struct MenuRow {
    id: int,
    title: string,
    enabled: bool,
    checked: bool,
    separator: bool,
}

component MenuButton inherits Rectangle {
    in property <string> text;
    in property <[MenuRow]> items;
    out property <bool> open: popup.is-open;
    callback picked(id: int);
    width: 140px;
    height: 34px;
    border-radius: 8px;
    background: popup.is-open ? #1d4ed8 : ta.has-hover ? #334155 : #1e293b;
    Text { text: root.text; color: white; }
    ta := TouchArea {
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: max(root.width, 200px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        forward-focus: keys;
        Rectangle {
            background: #0f172a;
            border-radius: 8px;
            border-width: 1px;
            border-color: #334155;
        }
        keys := FocusScope {
            key-pressed(e) => {
                if e.text == Key.Escape { popup.close(); return accept; }
                reject
            }
            VerticalLayout {
                padding: 4px;
                for row[i] in root.items: Rectangle {
                    height: row.separator ? 9px : 32px;
                    border-radius: 6px;
                    background: !row.separator && item-ta.has-hover && row.enabled ? #1e293b : transparent;
                    if row.separator: Rectangle { height: 1px; background: #334155; }
                    if !row.separator: HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text { width: 16px; text: row.checked ? "v" : ""; color: #38bdf8; vertical-alignment: center; }
                        Text { text: row.title; color: row.enabled ? white : #64748b; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    }
                    item-ta := TouchArea {
                        enabled: row.enabled && !row.separator;
                        clicked => {
                            root.picked(row.id);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

component NestedPopups inherits Rectangle {
    width: 120px;
    height: 34px;
    background: #334155;
    TouchArea { clicked => { first.show(); } }
    first := PopupWindow {
        x: 0px;
        y: root.height;
        width: 160px;
        height: 80px;
        close-policy: PopupClosePolicy.no-auto-close;
        Rectangle { background: #0f172a; }
        VerticalLayout {
            Rectangle {
                height: 30px;
                Text { text: "open second"; color: white; }
                TouchArea { clicked => { second.show(); } }
            }
            Rectangle {
                height: 30px;
                Text { text: "close"; color: white; }
                TouchArea { clicked => { first.close(); } }
            }
        }
        second := PopupWindow {
            x: 160px;
            y: 0px;
            width: 120px;
            height: 40px;
            close-policy: PopupClosePolicy.close-on-click;
            Rectangle { background: #1d4ed8; }
        }
    }
}

export component Demo inherits Window {
    in property <[MenuRow]> sort-items: [
        { id: 1, title: "Newest first", enabled: true, checked: true },
        { id: 2, title: "Name", enabled: true },
        { separator: true },
        { id: 3, title: "Size", enabled: false },
    ];
    in property <[string]> recent-folders: ["C:/Downloads", "D:/Video"];
    in-out property <bool> show-speed: true;
    in-out property <int> context-row: -1;
    callback sort-picked(id: int);
    callback menu-action(action: string, row: int);
    callback folder-picked(index: int);
    public function open-row-menu(x: length, y: length) {
        row-menu.show({ x: x, y: y });
    }
    public function close-row-menu() {
        row-menu.close();
    }
    preferred-width: 640px;
    preferred-height: 400px;

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Add link";
                shortcut: @keys(Control + N);
                activated => { root.menu-action("add", -1); }
            }
            Menu {
                title: "Recent folders";
                for folder[i] in root.recent-folders: MenuItem {
                    title: folder;
                    activated => { root.folder-picked(i); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Show speed";
                checkable: true;
                checked <=> root.show-speed;
            }
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 12px;
        alignment: start;
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            MenuButton {
                text: "Sort";
                items: root.sort-items;
                picked(id) => { root.sort-picked(id); }
                Tooltip { text: @markdown("Change the **sort** order: \{root.sort-items[0].title}"); }
            }
            NestedPopups { }
            Rectangle {
                width: 120px;
                height: 34px;
                background: #475569;
                Tooltip {
                    Rectangle {
                        background: #0f172a;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding: 6px;
                            Text { text: "Custom tooltip content"; color: white; }
                        }
                    }
                }
            }
        }
        row-menu := ContextMenuArea {
            height: 120px;
            Menu {
                MenuItem {
                    title: root.context-row >= 0 ? "Open file" : "Add link";
                    activated => { root.menu-action("open", root.context-row); }
                }
                MenuItem {
                    title: "Show speed";
                    checkable: true;
                    checked <=> root.show-speed;
                }
                MenuSeparator { }
                Menu {
                    title: "Move to";
                    enabled: root.recent-folders.length > 0;
                    for folder[i] in root.recent-folders: MenuItem {
                        title: folder;
                        activated => { root.folder-picked(i); }
                    }
                }
                if root.context-row >= 0: MenuItem {
                    title: "Delete";
                    activated => { root.menu-action("delete", root.context-row); }
                }
            }
            Rectangle { background: #1e293b; }
        }
    }
}
