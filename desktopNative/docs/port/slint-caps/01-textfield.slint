export global FieldTheme {
    in-out property <color> surface: #0F1728;
    in-out property <color> outline: #334155;
    in-out property <color> primary: #00E5FF;
    in-out property <color> error: #F87171;
    in-out property <color> text: #F1F5F9;
    in-out property <color> hint: #94A3B8;
}

export component FjTextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <string> label;
    in property <string> error;
    in property <image> leading-icon;
    in property <bool> password: false;
    in property <bool> read-only <=> input.read-only;
    in property <bool> enabled <=> input.enabled;
    in property <bool> centered: false;
    in property <bool> select-all-on-focus: false;
    in property <InputType> input-type: InputType.text;
    in-out property <bool> revealed: false;
    out property <bool> has-focus: input.has-focus;
    out property <bool> hovered: hover.has-hover;
    callback accepted(text: string);
    callback edited(text: string);
    callback paste-requested() -> bool;
    public function select-all() { input.select-all(); }
    public function clear-selection() { input.clear-selection(); }
    public function set-selection(anchor: int, focus: int) { input.set-selection-offsets(anchor, focus); }
    public function copy() { input.copy(); }
    public function cut() { input.cut(); }
    public function paste() { input.paste(); }
    public function undo() { input.undo(); }
    public function redo() { input.redo(); }
    public function focus-field() { input.focus(); }
    public function unfocus() { input.clear-focus(); }

    forward-focus: input;
    min-height: 44px;
    min-width: 80px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 10px;
    border-width: input.has-focus ? 2px : 1px;
    border-color: root.error != "" ? FieldTheme.error : input.has-focus ? FieldTheme.primary : hover.has-hover ? FieldTheme.hint : FieldTheme.outline;
    background: FieldTheme.surface;
    drop-shadow-blur: input.has-focus ? 10px : 0px;
    drop-shadow-color: input.has-focus ? FieldTheme.primary.with-alpha(0.35) : transparent;
    animate border-color, drop-shadow-blur, drop-shadow-color { duration: 120ms; easing: ease-out; }

    hover := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        cross-axis-alignment: center;
        if root.leading-icon.width > 0: Image {
            source: root.leading-icon;
            width: 18px;
            height: 18px;
            colorize: FieldTheme.hint;
        }
        clipper := Rectangle {
            horizontal-stretch: 1;
            cross-axis-self-alignment: stretch;
            clip: true;
            Text {
                x: 0;
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                horizontal-alignment: root.centered ? center : left;
                text: (input.text == "" && input.preedit-text == "") ? root.placeholder : "";
                color: FieldTheme.hint;
                font-size: input.font-size;
                overflow: elide;
            }
            ContextMenuArea {
                enabled: root.enabled;
                Menu {
                    if !root.read-only: MenuItem { title: "Undo"; activated => { input.undo(); } }
                    if !root.read-only: MenuItem { title: "Redo"; activated => { input.redo(); } }
                    if !root.read-only: MenuSeparator { }
                    MenuItem { title: "Cut"; enabled: !root.read-only; activated => { input.cut(); } }
                    MenuItem { title: "Copy"; enabled: !input.text.is-empty; activated => { input.copy(); } }
                    MenuItem { title: "Paste"; enabled: !root.read-only; activated => { input.paste(); } }
                    MenuItem { title: "Select all"; enabled: !input.text.is-empty; activated => { input.select-all(); } }
                }
                input := TextInput {
                    property <length> shift;
                    property <length> margin: 2px;
                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.shift));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: 100%;
                    single-line: true;
                    vertical-alignment: center;
                    horizontal-alignment: root.centered ? center : left;
                    font-size: 14px;
                    color: FieldTheme.text;
                    selection-background-color: FieldTheme.primary.with-alpha(0.4);
                    selection-foreground-color: FieldTheme.text;
                    text-cursor-width: 1.5px;
                    input-type: root.password && !root.revealed ? InputType.password : root.input-type;
                    cursor-position-changed(pos) => {
                        if pos.x + self.shift < self.margin {
                            self.shift = -pos.x + self.margin;
                        } else if pos.x + self.shift > parent.width - self.margin - self.text-cursor-width {
                            self.shift = parent.width - pos.x - self.margin - self.text-cursor-width;
                        }
                    }
                    changed has-focus => {
                        if self.has-focus && root.select-all-on-focus {
                            self.select-all();
                        }
                        if !self.has-focus {
                            root.revealed = false;
                        }
                    }
                    accepted => { root.accepted(self.text); }
                    edited => { root.edited(self.text); }
                    key-pressed(event) => {
                        if event.modifiers.control && event.text == "v" {
                            return root.paste-requested() ? accept : reject;
                        }
                        if event.text == Key.Escape {
                            self.clear-focus();
                            return accept;
                        }
                        reject
                    }
                }
            }
        }
        @children
    }
}

export component FieldIconButton inherits Rectangle {
    in property <string> glyph;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: ta.pressed ? FieldTheme.hint.with-alpha(0.3) : ta.has-hover ? FieldTheme.hint.with-alpha(0.15) : transparent;
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    Text { text: root.glyph; color: FieldTheme.hint; font-size: 14px; }
}

export component Demo inherits Window {
    in-out property <string> url;
    callback paste-url() -> bool;
    callback submitted(text: string);
    preferred-width: 480px;
    preferred-height: 220px;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;
        field := FjTextField {
            text <=> root.url;
            placeholder: "Paste a link";
            select-all-on-focus: true;
            paste-requested => { root.paste-url() }
            accepted(t) => { root.submitted(t); }
            FieldIconButton { glyph: "x"; clicked => { field.text = ""; field.focus-field(); } }
            FieldIconButton { glyph: "P"; clicked => { field.paste(); } }
        }
        pass := FjTextField {
            placeholder: "Password";
            password: true;
            FieldIconButton { glyph: pass.revealed ? "o" : "*"; clicked => { pass.revealed = !pass.revealed; } }
        }
        multi := TextInput {
            height: 60px;
            single-line: false;
            wrap: word-wrap;
            text: "line 1\nline 2";
        }
    }
}
