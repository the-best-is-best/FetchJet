import { Theme, Dir } from "../theme.slint";
import { HBox, T, Hover } from "../widgets/Base.slint";
import { ElideText } from "../widgets/ElideText.slint";
import { FilledButton } from "../widgets/Buttons.slint";
import { ListView } from "../widgets/Scroll.slint";
import { Tr } from "../generated/tr.slint";

export struct PlayerRow { title: string, video: bool, active: bool }

export global PlayerUi {
    in-out property <bool> open;
    in property <image> frame;
    in property <bool> has-video;
    in property <string> title;
    in property <int> index;
    in property <int> count;
    in property <bool> playing;
    in property <float> position-s;
    in property <float> duration-s;
    in property <string> position-label;
    in property <string> duration-label;
    in property <float> speed;
    in property <string> speed-label;
    in property <int> hold;
    in property <bool> finished;
    in property <bool> failed;
    in property <[PlayerRow]> items;
    in property <[string]> speed-labels;
    callback close();
    callback toggle-play();
    callback seek(float);
    callback skip(int);
    callback next();
    callback previous();
    callback pick(int);
    callback set-speed(int);
    callback hold-start(bool);
    callback hold-end();
    callback start-over();
    callback surface-size(int, int);
}

component PBtn inherits Rectangle {
    in property <string> commands;
    in property <bool> filled;
    in property <bool> enabled: true;
    in property <length> size: 44px;
    in property <length> glyph-size: 24px;
    in property <color> ink: #FFFFFF;
    in property <color> container: transparent;
    in property <string> label;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.container;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Hover {
        border-radius: root.border-radius;
        ink: root.ink;
        hovered: ta.has-hover && root.enabled;
        pressed: ta.pressed && root.enabled;
    }
    Path {
        x: (parent.width - root.glyph-size) / 2;
        y: (parent.height - root.glyph-size) / 2;
        width: root.glyph-size;
        height: root.glyph-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: root.filled ? (root.enabled ? root.ink : root.ink.with-alpha(0.35)) : transparent;
        stroke: root.filled ? transparent : (root.enabled ? root.ink : root.ink.with-alpha(0.35));
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

component Arrows inherits Rectangle {
    in property <bool> forward;
    width: 22px;
    height: 14px;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 22;
        viewbox-height: 14;
        commands: root.forward ? "M 1 1 L 10 7 L 1 13 Z M 12 1 L 21 7 L 12 13 Z" : "M 10 1 L 1 7 L 10 13 Z M 21 1 L 12 7 L 21 13 Z";
        fill: #FFFFFF;
    }
}

component Seek inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    out property <bool> dragging: ta.pressed;
    out property <float> dragged-s: root.live * root.duration;
    callback released(float);
    private property <float> frac: root.duration > 0 ? clamp(root.position / root.duration, 0, 1) : 0;
    private property <float> live: ta.pressed ? clamp(ta.mouse-x / max(root.width, 1px), 0, 1) : root.frac;
    height: 28px;
    accessible-role: slider;
    accessible-value: root.position;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.duration;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: ta.pressed || ta.has-hover ? 6px : 4px;
        border-radius: self.height / 2;
        background: #FFFFFF40;
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * root.live;
            height: parent.height;
            border-radius: parent.border-radius;
            background: Theme.primary;
        }
    }
    Rectangle {
        x: clamp(root.width * root.live - self.width / 2, 0px, root.width - self.width);
        y: (parent.height - self.height) / 2;
        width: ta.pressed || ta.has-hover ? 16px : 12px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.primary;
        border-width: 2px;
        border-color: #FFFFFF;
    }
    ta := TouchArea {
        enabled: root.duration > 0;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                root.released(clamp(self.mouse-x / max(root.width, 1px), 0, 1) * root.duration);
            }
        }
    }
}

component RowTag inherits Rectangle {
    in property <bool> video;
    width: tag.preferred-width + 14px;
    height: 20px;
    border-radius: 10px;
    background: Theme.primary.with-alpha(0.16);
    tag := Text {
        text: root.video ? Tr.linkTagVideo : Tr.linkTagAudio;
        color: Theme.primary;
        font-family: Theme.font;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ListSheet inherits Rectangle {
    callback dismissed();
    background: #00000099;
    TouchArea {
        clicked => { root.dismissed(); }
    }
    Rectangle {
        y: parent.height - self.height;
        height: parent.height * 0.6;
        background: Theme.surface;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        clip: true;
        TouchArea { }
        Rectangle {
            y: 10px;
            width: 40px;
            height: 4px;
            border-radius: 2px;
            background: Theme.on-surface.with-alpha(0.2);
        }
        ListView {
            y: 24px;
            height: parent.height - 24px;
            content-height: PlayerUi.items.length * 56px + 12px;
            for row[i] in PlayerUi.items: Rectangle {
                x: 8px;
                y: i * 56px;
                width: parent.width - 16px;
                height: 56px;
                border-radius: 10px;
                background: row.active ? Theme.primary.with-alpha(0.16) : transparent;
                accessible-role: button;
                accessible-label: row.title;
                accessible-action-default => {
                    PlayerUi.pick(i);
                    root.dismissed();
                }
                ta := TouchArea {
                    clicked => {
                        PlayerUi.pick(i);
                        root.dismissed();
                    }
                }
                HBox {
                    x: 12px;
                    width: parent.width - 24px;
                    height: parent.height;
                    spacing: 12px;
                    cross-axis-alignment: center;
                    Text {
                        width: 28px;
                        text: i + 1;
                        color: row.active ? Theme.primary : Theme.on-surface-variant;
                        font-family: Theme.font;
                        font-size: 13px;
                        font-weight: row.active ? 700 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ElideText {
                        text: row.title;
                        font-size: 14px;
                        font-weight: row.active ? 700 : 400;
                        ink: row.active ? Theme.primary : Theme.on-surface;
                        behind: row.active ? Theme.surface : Theme.surface;
                        tracking: 0.1px;
                        height: 56px;
                    }
                    RowTag {
                        video: row.video;
                    }
                }
                Hover {
                    border-radius: parent.border-radius;
                    hovered: ta.has-hover;
                    pressed: ta.pressed;
                }
            }
        }
    }
}

export component PlayerPage inherits Rectangle {
    private property <bool> shown: true;
    private property <bool> list-open: false;
    private property <bool> speed-open: false;
    private property <bool> holding: false;
    private property <bool> suppress: false;
    private property <bool> held: false;
    private property <length> down-x: 0px;
    private property <length> down-y: 0px;
    private property <bool> controls-on: root.shown || !PlayerUi.playing || PlayerUi.finished || PlayerUi.failed || root.list-open || root.speed-open;
    pure function two(n: int) -> string {
        return (n < 10 ? "0" : "") + n;
    }
    pure function fmt(s: float) -> string {
        return (Math.floor(s / 3600) > 0 ? Math.floor(s / 3600) + ":" + root.two(Math.floor(Math.mod(s, 3600) / 60)) : "" + Math.floor(Math.mod(s, 3600) / 60))
            + ":" + root.two(Math.floor(Math.mod(s, 60)));
    }
    function wake() {
        root.shown = true;
        hide-timer.restart();
    }
    background: #000000;
    init => { keys.focus(); }
    changed width => { PlayerUi.surface-size(Math.round(self.width / 1phx), Math.round(self.height / 1phx)); }
    changed height => { PlayerUi.surface-size(Math.round(self.width / 1phx), Math.round(self.height / 1phx)); }
    hide-timer := Timer {
        interval: 3500ms;
        running: PlayerUi.playing && root.shown && !root.list-open && !root.speed-open && !PlayerUi.finished && !PlayerUi.failed;
        triggered => { root.shown = false; }
    }
    hold-timer := Timer {
        interval: 350ms;
        running: root.holding;
        triggered => {
            root.holding = false;
            root.held = true;
            root.suppress = true;
            PlayerUi.hold-start(root.down-x > video.width / 2);
        }
    }
    keys := FocusScope {
        key-pressed(e) => {
            root.wake();
            if e.text == Key.Escape {
                if root.list-open {
                    root.list-open = false;
                } else if root.speed-open {
                    root.speed-open = false;
                } else {
                    PlayerUi.close();
                }
                return accept;
            }
            if e.text == " " {
                PlayerUi.toggle-play();
                return accept;
            }
            if e.text == Key.LeftArrow {
                PlayerUi.skip(-10000);
                return accept;
            }
            if e.text == Key.RightArrow {
                PlayerUi.skip(10000);
                return accept;
            }
            if e.text == Key.UpArrow || e.text == Key.DownArrow {
                return accept;
            }
            reject
        }
    }
    video := Rectangle {
        width: parent.width;
        height: parent.height;
        if PlayerUi.has-video: Image {
            width: parent.width;
            height: parent.height;
            source: PlayerUi.frame;
            image-fit: contain;
        }
        if !PlayerUi.has-video && !PlayerUi.failed: Rectangle {
            width: parent.width;
            height: parent.height;
            VerticalLayout {
                alignment: center;
                spacing: 18px;
                Rectangle {
                    height: 120px;
                    Rectangle {
                        width: 120px;
                        height: 120px;
                        border-radius: 60px;
                        background: Theme.primary.with-alpha(0.18);
                        Path {
                            x: 30px;
                            y: 30px;
                            width: 60px;
                            height: 60px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M 9 18 V 5 L 20 3 V 16";
                            stroke: Theme.primary;
                            stroke-width: 2px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                            fill: transparent;
                        }
                        Path {
                            x: 30px;
                            y: 30px;
                            width: 60px;
                            height: 60px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M 9 18 A 3 3 0 1 1 3 18 A 3 3 0 1 1 9 18 Z M 20 16 A 3 3 0 1 1 14 16 A 3 3 0 1 1 20 16 Z";
                            fill: Theme.primary;
                        }
                    }
                }
                Text {
                    x: 0px;
                    width: parent.width;
                    height: 60px;
                    text: PlayerUi.title;
                    color: #FFFFFF;
                    font-family: Theme.font;
                    font-size: 20px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: top;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }
        if PlayerUi.failed: Rectangle {
            width: 96px;
            height: 96px;
            border-radius: 20px;
            background: #FFFFFF14;
            Path {
                x: 24px;
                y: 24px;
                width: 48px;
                height: 48px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 12 3 L 22 20 L 2 20 Z M 12 9 L 12 14 M 12 17 L 12 17.01";
                stroke: Theme.error;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: transparent;
            }
        }
        video-ta := TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.move {
                    root.wake();
                }
                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                    root.suppress = false;
                    root.down-x = self.mouse-x;
                    root.down-y = self.mouse-y;
                    root.holding = true;
                    root.list-open = false;
                    root.speed-open = false;
                }
                if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                    root.holding = false;
                    if root.held {
                        root.held = false;
                        PlayerUi.hold-end();
                    }
                }
            }
            moved => {
                if root.holding && (abs(self.mouse-x - root.down-x) > 12px || abs(self.mouse-y - root.down-y) > 12px) {
                    root.holding = false;
                    root.suppress = true;
                }
            }
            clicked => {
                if !root.suppress {
                    root.shown = !root.controls-on;
                    hide-timer.restart();
                }
            }
            double-clicked => {
                root.suppress = true;
                PlayerUi.skip(self.mouse-x > self.width / 2 ? 10000 : -10000);
            }
        }
    }
    if PlayerUi.hold != 0: Rectangle {
        x: (parent.width - self.width) / 2;
        y: 72px;
        width: 86px;
        height: 34px;
        border-radius: 17px;
        background: #000000B3;
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Arrows {
                y: (parent.height - self.height) / 2;
                forward: PlayerUi.hold > 0;
            }
            Text {
                text: "2x";
                color: #FFFFFF;
                font-family: Theme.font;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
    if root.speed-open: TouchArea {
        clicked => { root.speed-open = false; }
    }
    top-bar := Rectangle {
        y: 0;
        width: parent.width;
        height: 60px;
        background: #000000A6;
        opacity: root.controls-on ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 150ms; }
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.move {
                    root.wake();
                }
            }
        }
        HBox {
            x: 8px;
            width: parent.width - 16px;
            height: parent.height;
            spacing: 8px;
            cross-axis-alignment: center;
            PBtn {
                commands: "M 5 5 L 19 19 M 19 5 L 5 19";
                label: Tr.cancel;
                clicked => { PlayerUi.close(); }
            }
            ElideText {
                text: PlayerUi.title;
                font-size: 16px;
                font-weight: 600;
                ink: #FFFFFF;
                behind: #000000;
                tracking: 0.1px;
                height: 60px;
            }
            if PlayerUi.count > 1: Text {
                text: (PlayerUi.index + 1) + "/" + PlayerUi.count;
                color: #FFFFFFCC;
                font-family: Theme.font;
                font-size: 14px;
                vertical-alignment: center;
            }
            if PlayerUi.count > 1: PBtn {
                commands: "M 9 6 L 20 6 M 9 12 L 20 12 M 9 18 L 20 18 M 4 6 L 4.01 6 M 4 12 L 4.01 12 M 4 18 L 4.01 18";
                label: Tr.playerPlayAll;
                clicked => {
                    root.list-open = !root.list-open;
                    root.speed-open = false;
                }
            }
        }
    }
    if PlayerUi.finished && PlayerUi.count > 1: Rectangle {
        x: 16px;
        y: parent.height - 112px - self.height - 12px;
        width: parent.width - 32px;
        height: 56px;
        border-radius: 14px;
        background: #000000CC;
        border-width: 1px;
        border-color: #FFFFFF26;
        HBox {
            x: 16px;
            width: parent.width - 32px;
            height: parent.height;
            spacing: 12px;
            cross-axis-alignment: center;
            Text {
                horizontal-stretch: 1;
                text: Tr.playerAllFinished;
                color: #FFFFFF;
                font-family: Theme.font;
                font-size: 14px;
                font-weight: 600;
                horizontal-alignment: Dir.start;
                vertical-alignment: center;
                overflow: elide;
            }
            FilledButton {
                height: 36px;
                pad: 18px;
                text: Tr.playerStartOver;
                clicked => { PlayerUi.start-over(); }
            }
        }
    }
    bottom-bar := Rectangle {
        y: parent.height - self.height;
        width: parent.width;
        height: 112px;
        background: #000000A6;
        opacity: root.controls-on ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 150ms; }
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.move {
                    root.wake();
                }
            }
        }
        Rectangle {
            x: 16px;
            y: 8px;
            width: parent.width - 32px;
            height: 28px;
            Text {
                x: 0px;
                width: 56px;
                height: parent.height;
                text: seek.dragging ? root.fmt(seek.dragged-s) : PlayerUi.position-label;
                color: #FFFFFF;
                font-family: Theme.font;
                font-size: 13px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            seek := Seek {
                x: 68px;
                width: parent.width - 136px;
                position: PlayerUi.position-s;
                duration: PlayerUi.duration-s;
                released(s) => {
                    PlayerUi.seek(s);
                    root.wake();
                }
            }
            Text {
                x: parent.width - 56px;
                width: 56px;
                height: parent.height;
                text: PlayerUi.duration-label;
                color: #FFFFFFB3;
                font-family: Theme.font;
                font-size: 13px;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }
        HBox {
            x: 16px;
            y: 44px;
            width: parent.width - 32px;
            height: 60px;
            spacing: 8px;
            cross-axis-alignment: center;
            speed-box := Rectangle {
                width: 72px;
                height: 40px;
                Rectangle {
                    border-radius: 20px;
                    background: #FFFFFF1F;
                    Text {
                        text: PlayerUi.speed-label;
                        color: #FFFFFF;
                        font-family: Theme.font;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    speed-ta := TouchArea {
                        clicked => {
                            root.speed-open = !root.speed-open;
                            root.list-open = false;
                        }
                    }
                    Hover {
                        border-radius: parent.border-radius;
                        ink: #FFFFFF;
                        hovered: speed-ta.has-hover;
                        pressed: speed-ta.pressed;
                    }
                }
                if root.speed-open: Rectangle {
                    x: Dir.rtl ? parent.width - self.width : 0px;
                    y: -self.height - 8px;
                    width: 96px;
                    height: PlayerUi.speed-labels.length * 40px + 12px;
                    border-radius: 12px;
                    background: Theme.surface-container;
                    border-width: 1px;
                    border-color: Theme.outline-variant;
                    TouchArea { }
                    for label[i] in PlayerUi.speed-labels: Rectangle {
                        x: 4px;
                        y: 6px + i * 40px;
                        width: parent.width - 8px;
                        height: 40px;
                        border-radius: 8px;
                        background: label == PlayerUi.speed-label ? Theme.primary.with-alpha(0.16) : transparent;
                        item-ta := TouchArea {
                            clicked => {
                                PlayerUi.set-speed(i);
                                root.speed-open = false;
                            }
                        }
                        Text {
                            text: label;
                            color: label == PlayerUi.speed-label ? Theme.primary : Theme.on-surface;
                            font-family: Theme.font;
                            font-size: 14px;
                            font-weight: label == PlayerUi.speed-label ? 700 : 400;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Hover {
                            border-radius: parent.border-radius;
                            hovered: item-ta.has-hover;
                            pressed: item-ta.pressed;
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                PBtn {
                    commands: "M 5 5 L 7 5 L 7 19 L 5 19 Z M 19 5 L 9 12 L 19 19 Z";
                    filled: true;
                    enabled: PlayerUi.index > 0;
                    label: "<";
                    clicked => { PlayerUi.previous(); }
                }
                PBtn {
                    size: 56px;
                    glyph-size: 28px;
                    filled: true;
                    container: Theme.primary;
                    ink: Theme.on-primary;
                    commands: PlayerUi.playing ? "M 7 5 L 10 5 L 10 19 L 7 19 Z M 14 5 L 17 5 L 17 19 L 14 19 Z" : "M 8 5 L 19 12 L 8 19 Z";
                    label: PlayerUi.playing ? "||" : ">";
                    clicked => { PlayerUi.toggle-play(); }
                }
                PBtn {
                    commands: "M 17 5 L 19 5 L 19 19 L 17 19 Z M 5 5 L 15 12 L 5 19 Z";
                    filled: true;
                    enabled: PlayerUi.index < PlayerUi.count - 1;
                    label: ">";
                    clicked => { PlayerUi.next(); }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Rectangle {
                width: 72px;
            }
        }
    }
    if root.list-open: ListSheet {
        dismissed => { root.list-open = false; }
    }
}
