import { Theme, Dir } from "../theme.slint";
import { HBox, T, Hover } from "../widgets/Base.slint";
import { TextButton, FilledButton, OutlinedButton } from "../widgets/Buttons.slint";
import { EmojiIcon } from "../widgets/Icons.slint";
import { ThinBar } from "../widgets/Progress.slint";
import { ChoiceChip, SegChoice } from "../widgets/Kit.slint";
import { ListView } from "../widgets/Scroll.slint";
import { TextField } from "../widgets/TextField.slint";
import { CheckBox } from "../widgets/CheckBox.slint";
import { Spinner } from "../widgets/Kit.slint";
import { PickMenu } from "../widgets/Menu.slint";
import { TorrentFilesCard } from "AddTorrent.slint";
import { SubtitlesCard } from "AddMedia.slint";
import { Core, LinkRowDto, LinkLineCode, LinkTagCode, GrabGroupDto } from "../generated/dto.slint";
import { Tr } from "../generated/tr.slint";
import { Act } from "../generated/actions.slint";

component QualityChip inherits Rectangle {
    in property <LinkRowDto> data;
    in property <length> limit;
    width: min(root.limit, name.preferred-width + arrow.preferred-width + 28px);
    height: 36px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.primary.with-alpha(0.5);
    background: Theme.primary.with-alpha(0.08);
    accessible-role: button;
    accessible-label: root.data.lineText;
    accessible-action-default => { menu.show(); }
    tap := TouchArea {
        clicked => { menu.show(); }
    }
    name := Text {
        x: Dir.rtl ? 10px + arrow.preferred-width + 8px : 10px;
        width: parent.width - arrow.preferred-width - 28px;
        text: root.data.lineText;
        color: Theme.primary;
        font-family: Theme.font;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: Dir.rtl ? 0px : 0.5px;
        vertical-alignment: center;
        overflow: elide;
    }
    arrow := Text {
        x: Dir.rtl ? 10px : parent.width - 10px - self.preferred-width;
        width: self.preferred-width;
        text: "▾";
        color: Theme.primary;
        font-family: Theme.symbol-font;
        font-size: 12px;
        vertical-alignment: center;
    }
    Hover {
        border-radius: 8px;
        ink: Theme.primary;
        hovered: tap.has-hover;
        pressed: tap.pressed;
    }
    menu := PickMenu {
        x: Dir.rtl ? min(0px, root.width - self.width) : 0;
        options: root.data.qualities;
        pick: root.data.qualityPick;
        font-size: 13px;
        anchor-top: root.absolute-position.y;
        anchor-height: root.height;
        picked(i) => { Act.setLinkQuality(root.data.index, root.data.qualityIndexes[i]); }
    }
}

component LinkRow inherits VerticalLayout {
    in property <LinkRowDto> data;
    in property <bool> divider;
    private property <bool> torrent: root.data.tagCode == LinkTagCode.torrent;
    private property <length> line-start: root.torrent ? 12px : 48px;
    private property <length> line-bottom: root.torrent ? 10px : 8px;
    private property <color> tag-ink: root.data.tagCode == LinkTagCode.audio ? #FBBF24
        : root.data.tagCode == LinkTagCode.video ? #E879F9
        : root.torrent ? #34D399 : #38BDF8;
    spacing: 0px;
    if root.divider: Rectangle {
        height: 1px;
        background: Theme.outline-variant.with-alpha(0.35);
    }
    Rectangle {
        height: 60px;
        opacity: root.data.rowLocked ? 0.55 : 1.0;
        ta := TouchArea {
            enabled: !root.data.rowLocked;
            clicked => { Act.toggleLink(root.data.index, !root.data.selected); }
        }
        Hover {
            hovered: ta.has-hover && !root.data.rowLocked;
            pressed: ta.pressed && !root.data.rowLocked;
        }
        Rectangle {
            x: Dir.rtl ? parent.width - 44px : 4px;
            width: 40px;
            height: 40px;
            if !root.data.rowLocked: CheckBox {
                checked: root.data.selected;
                label: root.data.title;
                toggled(on) => { Act.toggleLink(root.data.index, on); }
            }
            if root.data.rowLocked: Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 2px;
                border-width: 2px;
                border-color: Theme.on-surface.with-alpha(0.26);
                background: transparent;
            }
        }
        tag := Rectangle {
            x: Dir.rtl ? 12px : parent.width - 12px - self.width;
            width: word.preferred-width + 14px;
            height: 30px;
            border-radius: 6px;
            background: root.tag-ink.with-alpha(0.15);
            word := Text {
                text: root.data.tag;
                color: root.tag-ink;
                font-family: Theme.font;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: Dir.rtl ? 0px : 0.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        T {
            x: Dir.rtl ? 12px + tag.width + 8px : 48px;
            y: 6px;
            width: parent.width - 68px - tag.width;
            text: root.data.title;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
        }
        T {
            x: Dir.rtl ? 12px + tag.width + 8px : 48px;
            y: 30px;
            width: parent.width - 68px - tag.width;
            text: root.data.host;
            font-size: 11px;
            color: Theme.on-surface-variant;
            overflow: elide;
        }
    }
    if root.data.line == LinkLineCode.inspecting: Rectangle {
        height: 24px + root.line-bottom;
        Rectangle {
            x: Dir.rtl ? parent.width - root.line-start - 14px : root.line-start;
            y: 5px;
            width: 14px;
            height: 14px;
            Spinner {
                size: 14px;
            }
        }
        T {
            x: Dir.rtl ? 12px : root.line-start + 22px;
            y: 0;
            width: parent.width - root.line-start - 34px;
            text: root.data.lineText;
            font-size: 12px;
            color: Theme.on-surface-variant;
            overflow: elide;
        }
    }
    if root.data.line == LinkLineCode.qualities: Rectangle {
        height: 36px + 8px;
        QualityChip {
            x: Dir.rtl ? parent.width - 48px - self.width : 48px;
            y: 0;
            limit: parent.width - 60px;
            data: root.data;
        }
    }
    if root.data.line == LinkLineCode.failed: Rectangle {
        height: 48px + 8px;
        HBox {
            x: Dir.rtl ? 12px : 48px;
            y: 0;
            width: parent.width - 60px;
            height: 48px;
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;
            T {
                text: root.data.lineText;
                font-size: 12px;
                color: Theme.error;
                overflow: elide;
            }
            TextButton {
                text: Tr.retry;
                font-size: 12px;
                font-weight: 600;
                clicked => { Act.retryLinkInspect(root.data.index); }
            }
        }
    }
    if root.data.line == LinkLineCode.files: VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 10px;
        TorrentFilesCard {
            name: root.data.filesName;
            files: root.data.files;
            all-selected: root.data.filesAllSelected;
            toggled(index, on) => { Act.toggleLinkTorrentFile(root.data.index, index, on); }
            cycled(index) => { Act.cycleLinkTorrentFilePriority(root.data.index, index); }
            select-all(on) => { Act.selectAllLinkTorrentFiles(root.data.index, on); }
        }
    }
    if root.data.line == LinkLineCode.error: VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 10px;
        Text {
            min-height: 24px;
            text: root.data.lineText;
            color: Theme.error;
            font-family: Theme.font;
            font-size: 12px;
            letter-spacing: Dir.rtl ? 0px : 0.5px;
            horizontal-alignment: Dir.start;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

component GrabRow inherits Rectangle {
    in property <LinkRowDto> data;
    private property <color> tag-ink: root.data.tagCode == LinkTagCode.audio ? #FBBF24
        : root.data.tagCode == LinkTagCode.video ? #E879F9 : #38BDF8;
    height: 56px;
    ta := TouchArea {
        enabled: !root.data.rowLocked;
        clicked => { Act.toggleLink(root.data.index, !root.data.selected); }
    }
    Hover {
        hovered: ta.has-hover && !root.data.rowLocked;
        pressed: ta.pressed && !root.data.rowLocked;
    }
    Rectangle {
        x: Dir.rtl ? parent.width - 44px : 4px;
        y: 8px;
        width: 40px;
        height: 40px;
        if !root.data.rowLocked: CheckBox {
            checked: root.data.selected;
            label: root.data.title;
            toggled(on) => { Act.toggleLink(root.data.index, on); }
        }
        if root.data.rowLocked: Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 2px;
            border-width: 2px;
            border-color: Theme.on-surface.with-alpha(0.26);
            background: transparent;
        }
    }
    tag := Rectangle {
        x: Dir.rtl ? 12px : parent.width - 12px - self.width;
        y: 13px;
        width: word.preferred-width + 14px;
        height: 30px;
        border-radius: 6px;
        background: root.tag-ink.with-alpha(0.15);
        word := Text {
            text: root.data.tag;
            color: root.tag-ink;
            font-family: Theme.font;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: Dir.rtl ? 0px : 0.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    T {
        x: Dir.rtl ? 12px + tag.width + 8px : 48px;
        y: 6px;
        width: parent.width - 68px - tag.width;
        text: root.data.title;
        font-size: 13px;
        font-weight: 600;
        color: root.data.rowLocked ? Theme.on-surface.with-alpha(0.5) : Theme.on-surface;
        overflow: elide;
    }
    T {
        x: Dir.rtl ? 12px + tag.width + 8px : 48px;
        y: 30px;
        width: parent.width - 68px - tag.width;
        text: root.data.host;
        font-size: 11px;
        color: Theme.on-surface-variant;
        overflow: elide;
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.outline-variant.with-alpha(0.35);
    }
}

component GrabGroupChip inherits Rectangle {
    in property <GrabGroupDto> data;
    height: 32px;
    width: label.preferred-width + 22px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.data.selected ? Theme.primary : Theme.outline-variant.with-alpha(0.6);
    background: root.data.selected ? Theme.primary.with-alpha(0.18) : Theme.surface.with-alpha(0.6);
    accessible-role: button;
    accessible-label: root.data.label;
    accessible-checkable: true;
    accessible-checked: root.data.selected;
    accessible-action-default => { Act.toggleGrabGroup(root.data.folder, !root.data.selected); }
    ta := TouchArea {
        clicked => { Act.toggleGrabGroup(root.data.folder, !root.data.selected); }
    }
    label := Text {
        text: root.data.label;
        color: root.data.selected ? Theme.primary : Theme.on-surface-variant;
        font-family: Theme.font;
        font-size: 12px;
        font-weight: root.data.selected ? 700 : 500;
        letter-spacing: Dir.rtl ? 0px : 0.3px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Hover {
        border-radius: 16px;
        hovered: ta.has-hover;
        pressed: ta.pressed;
    }
}

export component GrabNote inherits VerticalLayout {
    padding-top: 2px;
    padding-bottom: 2px;
    Text {
        text: Core.add.grabNote;
        color: Theme.on-surface-variant;
        font-family: Theme.font;
        font-size: 11px;
        letter-spacing: Dir.rtl ? 0px : 0.3px;
        horizontal-alignment: Dir.start;
        wrap: word-wrap;
    }
}

export component GrabCard inherits Rectangle {
    private property <int> depth-pick: Core.add.grabDepths[1].selected ? 1 : Core.add.grabDepths[2].selected ? 2 : 0;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.outline-variant.with-alpha(0.6);
    background: Theme.surface-variant.with-alpha(0.25);
    height: body.preferred-height;
    body := VerticalLayout {
        padding: 14px;
        spacing: 0px;
        HBox {
            height: 28px;
            spacing: 8px;
            cross-axis-alignment: center;
            EmojiIcon {
                glyph: "📥";
                size: 16px;
                ink: Theme.primary;
            }
            T {
                horizontal-stretch: 1;
                text: Tr.grabFindFiles;
                font-size: 14px;
                font-weight: 700;
                overflow: elide;
            }
        }
        if !Core.add.grabRunning && !Core.add.grabDepthHidden: Rectangle {
            height: 8px;
        }
        if !Core.add.grabRunning && !Core.add.grabDepthHidden: T {
            text: Tr.grabHow;
            font-size: 11px;
            color: Theme.on-surface-variant;
            overflow: elide;
        }
        if !Core.add.grabRunning && !Core.add.grabDepthHidden: Rectangle {
            height: 4px;
        }
        if !Core.add.grabRunning && !Core.add.grabDepthHidden: SegChoice {
            options: [Tr.grabDepthShort1, Tr.grabDepthShort2, Tr.grabDepthShort3];
            pick: root.depth-pick;
            picked(i) => { Act.setGrabDepth(i + 1); }
        }
        if !Core.add.grabRunning && !Core.add.grabDepthHidden: Rectangle {
            height: 6px;
        }
        if !Core.add.grabRunning && !Core.add.grabDepthHidden: T {
            text: root.depth-pick == 0 ? Tr.grabDepth1 : root.depth-pick == 1 ? Tr.grabDepth2 : Tr.grabDepth3;
            font-size: 11px;
            color: Theme.on-surface-variant;
            overflow: elide;
        }
        if !Core.add.grabRunning: Rectangle {
            height: 12px;
        }
        if !Core.add.grabRunning: HBox {
            height: 40px;
            alignment: start;
            FilledButton {
                text: Tr.grabFindFiles;
                border-radius: 10px;
                font-size: 13px;
                font-weight: 700;
                clicked => { Act.grabPage(); }
            }
        }
        if Core.add.grabRunning: Rectangle {
            height: 10px;
        }
        if Core.add.grabRunning: HBox {
            height: 24px;
            spacing: 8px;
            cross-axis-alignment: center;
            Spinner {
                size: 16px;
            }
            T {
                horizontal-stretch: 1;
                text: Core.add.grabReading;
                font-size: 12px;
                color: Theme.on-surface-variant;
                overflow: elide;
            }
        }
        if Core.add.grabRunning: Rectangle {
            height: 10px;
        }
        if Core.add.grabRunning: ThinBar {
            indeterminate: true;
        }
        if Core.add.grabRunning: Rectangle {
            height: 12px;
        }
        if Core.add.grabRunning: HBox {
            height: 40px;
            alignment: start;
            OutlinedButton {
                text: Tr.grabStop;
                border-radius: 10px;
                font-size: 12px;
                font-weight: 600;
                ink: Theme.on-surface;
                clicked => { Act.grabCancel(); }
            }
        }
        if Core.add.grabNote != "" && !Core.add.grabRunning: Rectangle {
            height: 10px;
        }
        if Core.add.grabNote != "" && !Core.add.grabRunning: GrabNote { }
    }
}

export component LinkListSection inherits VerticalLayout {
    spacing: 0px;
    if Core.add.linkGrabbed && !Core.add.grabShown && Core.add.grabNote != "": GrabNote { }
    if Core.add.linkGrabbed && !Core.add.grabShown && Core.add.grabNote != "": Rectangle {
        height: 6px;
    }
    if Core.add.linkGrabbed && Core.add.grabGroups.length > 0: FlexboxLayout {
        flex-direction: Dir.rtl ? row-reverse : row;
        flex-wrap: wrap;
        alignment: start;
        spacing: 6px;
        min-height: 32px;
        for group in Core.add.grabGroups: GrabGroupChip {
            data: group;
        }
    }
    HBox {
        height: 48px;
        spacing: 8px;
        cross-axis-alignment: center;
        T {
            horizontal-stretch: 1;
            text: Core.add.linkSummary;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
        }
        if Core.add.linkPickable: TextButton {
            text: Core.add.linkAllSelected ? Tr.selectNone : Tr.selectAll;
            font-size: 12px;
            font-weight: 600;
            clicked => { Act.selectAllLinks(!Core.add.linkAllSelected); }
        }
    }
    Rectangle {
        height: 29px;
        T {
            x: Dir.rtl ? 0 : 4px;
            y: 0;
            width: parent.width - 4px;
            text: Tr.playlistFolder;
            tracking: 0.3px;
            font-size: 11px;
            font-weight: 600;
            color: folder.has-focus ? Theme.primary : Theme.on-surface-variant;
            overflow: elide;
        }
    }
    folder := TextField {
        leading-emoji: "📁";
        value: Core.add.linkFolder;
        rev: Core.add.linkFolderRev;
        edited(text) => { Act.setLinkFolder(text); }
    }
    Rectangle {
        height: 36px;
        T {
            x: 0;
            y: 4px;
            width: parent.width;
            text: Tr.playlistFolderHint;
            font-size: 10px;
            color: Theme.on-surface-variant;
            overflow: elide;
        }
    }
    Rectangle {
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.outline-variant.with-alpha(0.6);
        background: Theme.surface-variant.with-alpha(0.25);
        clip: true;
        height: Core.add.linkGrabbed ? min(Core.addLinks.length * 56px + 2px, 340px) : self.preferred-height;
        if Core.add.linkGrabbed: ListView {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            for row in Core.addLinks: GrabRow {
                data: row;
            }
        }
        if !Core.add.linkGrabbed: VerticalLayout {
            padding: 1px;
            spacing: 0px;
            for row[i] in Core.addLinks: LinkRow {
                data: row;
                divider: i > 0;
            }
        }
    }
    if Core.addMedia.subtitlesShown: Rectangle {
        height: 12px;
    }
    if Core.addMedia.subtitlesShown: SubtitlesCard { }
}
