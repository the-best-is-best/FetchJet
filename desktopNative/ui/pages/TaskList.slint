import { Theme, Dir } from "../theme.slint";
import { HBox, T, Hover } from "../widgets/Base.slint";
import { FilledButton, OutlinedButton, TextButton, IconButton } from "../widgets/Buttons.slint";
import { CheckBox } from "../widgets/CheckBox.slint";
import { LinearProgress } from "../widgets/Progress.slint";
import { OptionsMenu } from "../widgets/Menu.slint";
import { ListView } from "../widgets/Scroll.slint";
import { EmojiIcon } from "../widgets/Icons.slint";
import { TaskRow } from "TaskRow.slint";
import { ChoiceChip, Spinner } from "../widgets/Kit.slint";
import { Core, ListKeyCode } from "../generated/dto.slint";
import { Act } from "../generated/actions.slint";
import { Tr } from "../generated/tr.slint";

component SortMenu inherits OptionsMenu {
    options: Core.chrome.sortOptions;
    font-size: 13px;
    check-first: true;
    picked(index) => { Act.setSort(index); }
}

component SortButton inherits TextButton {
    in property <bool> short;
    text: short ? "⇅ " + Core.chrome.sortChoice : Core.chrome.sortLabel;
    trail: "▾";
    height: 34px;
    pad: 10px;
    font-size: 12px;
    font-weight: 600;
    clicked => { menu.show(); }
    menu := SortMenu {
        x: Dir.rtl ? 0 : root.width - self.width;
        y: root.height;
    }
}

component BarButton inherits OutlinedButton {
    height: 34px;
    border-radius: 10px;
    pad: 12px;
    font-size: 12px;
    font-weight: 600;
}

component BarFilledButton inherits FilledButton {
    height: 34px;
    border-radius: 10px;
    pad: 12px;
    font-size: 12px;
    font-weight: 600;
}

component ToolsBanner inherits Rectangle {
    in property <string> text: Core.chrome.toolsBannerText;
    in property <float> fraction: Core.chrome.toolsBannerFraction;
    in property <bool> indeterminate: Core.chrome.toolsBannerIndeterminate;
    height: 46px + 8px;
    Rectangle {
        y: 0;
        height: 46px;
        border-radius: 12px;
        background: Theme.primary.with-alpha(0.1);
        T {
            x: 14px;
            y: 10px;
            width: parent.width - 28px;
            text: root.text;
            line: 16px;
            tracking: 0.4px;
            font-size: 12px;
            font-weight: 600;
            color: Theme.primary;
            overflow: elide;
        }
        LinearProgress {
            x: 14px;
            y: 32px;
            width: parent.width - 28px;
            value: root.fraction;
            indeterminate: root.indeterminate;
        }
    }
}

component WhenDoneBanner inherits Rectangle {
    height: 48px + 8px;
    Rectangle {
        y: 0;
        height: 48px;
        border-radius: 12px;
        background: Theme.tertiary.with-alpha(0.12);
        HBox {
            padding-start: 14px;
            padding-end: 4px;
            spacing: 0px;
            cross-axis-alignment: center;
            T {
                text: Core.chrome.whenDoneBannerText;
                line: 16px;
                tracking: 0.4px;
                font-size: 12px;
                font-weight: 600;
                color: Theme.tertiary;
                horizontal-stretch: 1;
                overflow: elide;
            }
            TextButton {
                text: Tr.cancel;
                clicked => { Act.cancelWhenDone(); }
            }
        }
    }
}

component ListToolbar inherits Rectangle {
    height: 34px + 8px;
    HBox {
        y: 0;
        height: 34px;
        spacing: 8px;
        cross-axis-alignment: center;
        BarButton {
            glyph: "⏸";
            text: Tr.homePauseAll;
            enabled: Core.chrome.anyPausable;
            clicked => { Act.pauseAll(); }
        }
        BarButton {
            glyph: "⬇";
            text: Tr.homeResumeAll;
            enabled: Core.chrome.anyResumable;
            clicked => { Act.resumeAll(); }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        SortButton { }
    }
}

component PlaylistBar inherits Rectangle {
    VerticalLayout {
        spacing: 6px;
        padding-bottom: 8px;
        HBox {
            height: 34px;
            spacing: 8px;
            cross-axis-alignment: center;
            TextButton {
                text: (Dir.rtl ? "▶ " : "◀ ") + Tr.playlistBack;
                height: 34px;
                pad: 10px;
                font-size: 12px;
                font-weight: 600;
                clicked => { Act.closePlaylist(); }
            }
            T {
                text: Core.chrome.playlistSummary;
                font-size: 13px;
                font-weight: 700;
                overflow: elide;
                horizontal-stretch: 1;
            }
            SortButton {
                short: true;
            }
        }
        HBox {
            height: 34px;
            spacing: 8px;
            cross-axis-alignment: center;
            if Core.chrome.playlistCanPlay: BarButton {
                glyph: "🎬";
                text: Tr.playerPlayAll;
                clicked => { Act.playOpenGroup(); }
            }
            if !Core.chrome.groupIsFolder && !Core.chrome.hiddenOpen: BarButton {
                glyph: "🔄";
                text: Core.chrome.groupIsPage ? Tr.grabCheckNew : Tr.playlistCheckNew;
                enabled: Core.chrome.playlistCanCheck;
                clicked => { Act.playlistCheck(); }
            }
            if !Core.chrome.hiddenOpen: BarButton {
                glyph: "📂";
                text: Tr.rowMenuOpenFolder;
                clicked => { Act.groupOpenFolderOnDisk(); }
            }
            BarButton {
                glyph: "⏸";
                text: Tr.homePauseAll;
                enabled: Core.chrome.playlistCanPause;
                clicked => { Act.playlistPauseAll(); }
            }
            BarButton {
                glyph: "⬇";
                text: Tr.homeResumeAll;
                enabled: Core.chrome.playlistCanResume;
                clicked => { Act.playlistResumeAll(); }
            }
            if Core.chrome.hiddenOpen: BarButton {
                text: Tr.hiddenUnhide;
                clicked => { Act.unhideGroup(); }
            }
            if !Core.chrome.hiddenOpen: BarButton {
                glyph: "🗑";
                text: (Core.chrome.groupIsFolder || Core.chrome.groupIsPage) ? Tr.folderDeleteAll : Tr.playlistDeleteAll;
                clicked => { Act.playlistRemove(); }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        if Core.chrome.groupIsFolder && !Core.chrome.hiddenOpen: HBox {
            height: 26px;
            cross-axis-alignment: center;
            T {
                text: "📁 " + Core.chrome.groupFolderPath;
                font-size: 11px;
                color: Theme.on-surface-variant;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        if !Core.chrome.groupIsFolder && !Core.chrome.groupIsPage && !Core.chrome.hiddenOpen: HBox {
            height: 30px;
            spacing: 8px;
            cross-axis-alignment: center;
            T {
                text: "💬 " + Core.chrome.playlistSubtitles;
                font-size: 12px;
                overflow: elide;
            }
            TextButton {
                text: "+ " + Tr.playlistAddLanguage;
                height: 30px;
                pad: 8px;
                font-size: 12px;
                font-weight: 600;
                enabled: !Core.chrome.playlistLanguagesBusy;
                clicked => { Act.playlistReadLanguages(); }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        if Core.chrome.playlistLanguagesShown && !Core.chrome.hiddenOpen: HBox {
            height: 40px;
            spacing: 6px;
            cross-axis-alignment: center;
            if Core.chrome.playlistLanguagesBusy: Spinner {
                size: 14px;
            }
            if Core.chrome.playlistLanguagesNote != "": T {
                text: Core.chrome.playlistLanguagesNote;
                font-size: 11px;
                color: Theme.on-surface-variant;
                overflow: elide;
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 40px;
                clip: true;
                HBox {
                    spacing: 6px;
                    alignment: start;
                    cross-axis-alignment: center;
                    for choice in Core.chrome.playlistLanguageChoices: ChoiceChip {
                        label: "+ " + choice.label;
                        selected: false;
                        clicked => { Act.playlistAddLanguage(choice.value); }
                    }
                }
            }
            TextButton {
                text: "✕";
                height: 30px;
                pad: 8px;
                font-size: 12px;
                enabled: !Core.chrome.playlistLanguagesBusy;
                clicked => { Act.playlistLanguagesClose(); }
            }
        }
    }
}

component HiddenActions inherits HBox {
    spacing: 8px;
    cross-axis-alignment: center;
    horizontal-stretch: 0;
    BarButton {
        text: Tr.hiddenUnhideAll;
        enabled: !Core.chrome.listEmpty;
        clicked => { Act.unhideAll(); }
    }
    BarButton {
        text: Core.chrome.hiddenChangeLabel;
        clicked => { Act.hiddenChangePin(); }
    }
    BarButton {
        text: Core.chrome.hiddenRemoveLabel;
        clicked => { Act.hiddenRemovePin(); }
    }
}

component HiddenRecoveryActions inherits HBox {
    spacing: 8px;
    cross-axis-alignment: center;
    horizontal-stretch: 0;
    BarButton {
        text: Tr.hiddenRecoveryTitle;
        clicked => { Act.hiddenRecoveryCode(); }
    }
    BarButton {
        text: Tr.hiddenRecoveryRestoreTitle;
        clicked => { Act.hiddenRestore(); }
    }
}

component HiddenBar inherits Rectangle {
    private property <bool> narrow: root.width < 1000px;
    VerticalLayout {
        spacing: 6px;
        padding-bottom: 8px;
        HBox {
            height: 34px;
            spacing: 8px;
            cross-axis-alignment: center;
            T {
                text: Tr.hiddenTitle;
                font-size: 13px;
                font-weight: 700;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if !root.narrow: HiddenActions { }
            if !root.narrow: HiddenRecoveryActions { }
            BarFilledButton {
                text: Tr.hiddenLock;
                clicked => { Act.hiddenLock(); }
            }
        }
        if root.narrow: HBox {
            height: 34px;
            cross-axis-alignment: center;
            HiddenActions { }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.narrow: HBox {
            height: 34px;
            cross-axis-alignment: center;
            HiddenRecoveryActions { }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        HBox {
            height: 26px;
            cross-axis-alignment: center;
            T {
                text: Core.chrome.hiddenNote;
                font-size: 11px;
                color: Theme.on-surface-variant;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
}

component SelectionBar inherits Rectangle {
    height: 34px + 8px;
    HBox {
        y: 0;
        height: 34px;
        spacing: 8px;
        cross-axis-alignment: center;
        IconButton {
            size: 34px;
            glyph: "✕";
            label: Tr.addClearSelection;
            glyph-size: 14px;
            clicked => { Act.clearChecks(); }
        }
        T {
            text: Core.chrome.selectedCountText;
            font-size: 13px;
            font-weight: 600;
            color: Theme.on-background;
        }
        TextButton {
            text: Core.chrome.allChecked ? Tr.selectNone : Tr.selectAll;
            height: 34px;
            pad: 10px;
            font-size: 12px;
            font-weight: 600;
            clicked => { Act.checkAll(!Core.chrome.allChecked); }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        if !Core.chrome.hiddenOpen: BarButton {
            text: Tr.hiddenHide;
            clicked => { Act.hideChecked(); }
        }
        if Core.chrome.hiddenOpen: BarButton {
            text: Tr.hiddenUnhide;
            clicked => { Act.unhideChecked(); }
        }
        if !Core.chrome.hiddenOpen: BarButton {
            text: Tr.homeExport;
            clicked => { Act.exportChecked(); }
        }
        if Core.chrome.canMerge: BarButton {
            text: "🎬  " + Tr.mergeVideos;
            clicked => { Act.mergeChecked(); }
        }
        BarFilledButton {
            text: "🗑  " + Tr.delete;
            container: Theme.error;
            ink: Theme.on-error;
            clicked => { Act.removeChecked(); }
        }
    }
}

component ColumnsHeader inherits Rectangle {
    height: 24px + 4px;
    HBox {
        y: 0;
        height: 24px;
        padding-start: 12px;
        padding-end: 12px;
        spacing: 12px;
        cross-axis-alignment: center;
        CheckBox {
            checked: Core.chrome.allChecked;
            label: Tr.selectAll;
            indeterminate: Core.chrome.selectionMode && !Core.chrome.allChecked;
            toggled => { Act.checkAll(!Core.chrome.allChecked); }
        }
        Rectangle {
            width: 34px;
        }
        T {
            text: Tr.homeColumnName;
            line: 16px;
            font-size: 11px;
            font-weight: 700;
            color: Theme.on-surface-variant;
            horizontal-stretch: 1;
        }
        T {
            width: 76px;
            text: Tr.homeColumnSize;
            line: 16px;
            font-size: 11px;
            font-weight: 700;
            color: Theme.on-surface-variant;
        }
        T {
            width: 140px;
            text: Tr.homeColumnProgress;
            line: 16px;
            font-size: 11px;
            font-weight: 700;
            color: Theme.on-surface-variant;
        }
        T {
            width: 84px;
            text: Tr.homeColumnSpeed;
            line: 16px;
            font-size: 11px;
            font-weight: 700;
            color: Theme.on-surface-variant;
        }
        T {
            width: 64px;
            text: Tr.homeColumnLeft;
            line: 16px;
            font-size: 11px;
            font-weight: 700;
            color: Theme.on-surface-variant;
        }
        Rectangle {
            width: 120px;
        }
    }
}

component EmptyState inherits Rectangle {
    VerticalLayout {
        alignment: center;
        spacing: 0px;
        HorizontalLayout {
            alignment: center;
            EmojiIcon {
                glyph: "📥";
                size: 56px;
                ink: Theme.on-surface-variant;
            }
        }
        Rectangle {
            height: 12px;
        }
        Text {
            height: 24px;
            text: Core.chrome.emptyTitle;
            color: Theme.on-surface-variant;
            font-family: Theme.font;
            font-size: 16px;
            font-weight: 500;
            letter-spacing: Dir.rtl ? 0px : 0.2px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            height: 16px;
            text: Core.chrome.emptyHint;
            color: Theme.on-surface-variant.with-alpha(0.7);
            font-family: Theme.font;
            font-size: 12px;
            letter-spacing: Dir.rtl ? 0px : 0.4px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component TaskList inherits Rectangle {
    public function scroll-to-top() {
        list.scroll-to-y(0px);
    }
    in property <bool> keys-enabled: true;
    callback focus-search();
    callback show-shortcuts();
    private property <bool> wide: root.width >= 720px;
    private property <length> open-height: (root.wide ? 68px : 90px) + 6px;
    private property <length> done-height: (root.wide ? 68px : 75px) + 6px;
    private property <int> page-rows: max(1, Math.floor(list.visible-height / root.open-height));
    private property <int> focus-rev: Core.chrome.focusRev;
    private property <bool> reveal-pending;
    private property <int> reveal-ask;
    changed focus-rev => {
        if Core.chrome.focusRow > 0 {
            root.reveal-pending = true;
            if Core.chrome.focusRow <= 2 {
                list.scroll-to-y(0px);
            } else {
                list.ensure-visible(Core.chrome.focusHeads * 38px + Core.chrome.focusDone * root.done-height
                    + (Core.chrome.focusRow - 1 - Core.chrome.focusHeads - Core.chrome.focusDone) * root.open-height,
                    root.open-height - 6px);
            }
            root.reveal-ask += 1;
        }
    }
    forward-focus: keys;
    keys := FocusScope {
        KeyBinding {
            keys: @keys(Control + R);
            enabled: root.keys-enabled;
            activated => { Act.listKey(ListKeyCode.resume, false, 0); }
        }
        KeyBinding {
            keys: @keys(Control + "ق");
            enabled: root.keys-enabled;
            activated => { Act.listKey(ListKeyCode.resume, false, 0); }
        }
        KeyBinding {
            keys: @keys(Control + "к");
            enabled: root.keys-enabled;
            activated => { Act.listKey(ListKeyCode.resume, false, 0); }
        }
        KeyBinding {
            keys: @keys(Control + P);
            enabled: root.keys-enabled;
            activated => { Act.listKey(ListKeyCode.pause, false, 0); }
        }
        KeyBinding {
            keys: @keys(Control + "ح");
            enabled: root.keys-enabled;
            activated => { Act.listKey(ListKeyCode.pause, false, 0); }
        }
        KeyBinding {
            keys: @keys(Control + "з");
            enabled: root.keys-enabled;
            activated => { Act.listKey(ListKeyCode.pause, false, 0); }
        }
        KeyBinding {
            keys: @keys(Control + O);
            enabled: root.keys-enabled;
            activated => { Act.listKey(ListKeyCode.open-file, false, 0); }
        }
        KeyBinding {
            keys: @keys(Control + "خ");
            enabled: root.keys-enabled;
            activated => { Act.listKey(ListKeyCode.open-file, false, 0); }
        }
        KeyBinding {
            keys: @keys(Control + "щ");
            enabled: root.keys-enabled;
            activated => { Act.listKey(ListKeyCode.open-file, false, 0); }
        }
        KeyBinding {
            keys: @keys(Control + E);
            enabled: root.keys-enabled;
            activated => { Act.listKey(ListKeyCode.open-folder, false, 0); }
        }
        KeyBinding {
            keys: @keys(Control + "ث");
            enabled: root.keys-enabled;
            activated => { Act.listKey(ListKeyCode.open-folder, false, 0); }
        }
        KeyBinding {
            keys: @keys(Control + "у");
            enabled: root.keys-enabled;
            activated => { Act.listKey(ListKeyCode.open-folder, false, 0); }
        }
        KeyBinding {
            keys: @keys(Control + N);
            enabled: root.keys-enabled;
            activated => { Act.showAddDialog(true); }
        }
        KeyBinding {
            keys: @keys(Control + "ى");
            enabled: root.keys-enabled;
            activated => { Act.showAddDialog(true); }
        }
        KeyBinding {
            keys: @keys(Control + "т");
            enabled: root.keys-enabled;
            activated => { Act.showAddDialog(true); }
        }
        KeyBinding {
            keys: @keys(Control + "د");
            enabled: root.keys-enabled;
            activated => { Act.showAddDialog(true); }
        }
        KeyBinding {
            keys: @keys(Control + F);
            enabled: root.keys-enabled;
            activated => { root.focus-search(); }
        }
        KeyBinding {
            keys: @keys(Control + "ب");
            enabled: root.keys-enabled;
            activated => { root.focus-search(); }
        }
        KeyBinding {
            keys: @keys(Control + "а");
            enabled: root.keys-enabled;
            activated => { root.focus-search(); }
        }
        key-pressed(e) => {
            if !root.keys-enabled {
                return reject;
            }
            if e.modifiers.control && (e.text == "a" || e.text == "A" || e.text == "ش" || e.text == "ф") {
                Act.listKey(ListKeyCode.select-all, false, 0);
                return accept;
            }
            if e.text == Key.Escape && Core.chrome.selectionMode {
                Act.listKey(ListKeyCode.escape, false, 0);
                return accept;
            }
            if e.text == Key.Delete {
                Act.listKey(ListKeyCode.delete, false, 0);
                return accept;
            }
            if e.text == Key.F1 {
                root.show-shortcuts();
                return accept;
            }
            if e.text == Key.UpArrow {
                Act.listKey(ListKeyCode.up, e.modifiers.shift, 0);
                return accept;
            }
            if e.text == Key.DownArrow {
                Act.listKey(ListKeyCode.down, e.modifiers.shift, 0);
                return accept;
            }
            if e.text == Key.Home {
                Act.listKey(ListKeyCode.home, e.modifiers.shift, 0);
                return accept;
            }
            if e.text == Key.End {
                Act.listKey(ListKeyCode.end, e.modifiers.shift, 0);
                return accept;
            }
            if e.text == Key.PageUp {
                Act.listKey(ListKeyCode.page-up, e.modifiers.shift, root.page-rows);
                return accept;
            }
            if e.text == Key.PageDown {
                Act.listKey(ListKeyCode.page-down, e.modifiers.shift, root.page-rows);
                return accept;
            }
            if e.text == Key.Return {
                if !e.repeat {
                    Act.listKey(e.modifiers.alt ? ListKeyCode.details : ListKeyCode.open, false, 0);
                }
                return accept;
            }
            reject
        }
        VerticalLayout {
            spacing: 0px;
            if Core.chrome.toolsBannerShown: ToolsBanner { }
            if Core.chrome.hiddenWorkShown: ToolsBanner {
                text: Core.chrome.hiddenWorkText;
                fraction: Core.chrome.hiddenWorkFraction;
                indeterminate: Core.chrome.hiddenWorkFraction <= 0;
            }
            if Core.chrome.whenDoneBannerShown: WhenDoneBanner { }
            if Core.chrome.selectionMode: SelectionBar { }
            if !Core.chrome.selectionMode && Core.chrome.playlistOpen: PlaylistBar { }
            if !Core.chrome.selectionMode && Core.chrome.hiddenOpen && !Core.chrome.playlistOpen: HiddenBar { }
            if !Core.chrome.selectionMode && Core.chrome.showToolbar: ListToolbar { }
            if !Core.chrome.listEmpty && root.width >= 720px: ColumnsHeader { }
            Rectangle {
                vertical-stretch: 1;
                if Core.chrome.listEmpty: EmptyState { }
                list := ListView {
                    y: 4px;
                    height: parent.height - 4px;
                    visible: !Core.chrome.listEmpty;
                    scrolled => { root.reveal-pending = false; }
                    for item in Core.tasks: TaskRow {
                        data: item;
                        selection-mode: Core.chrome.selectionMode;
                        focused: item.id == Core.chrome.focusId;
                        reveal-ask: root.reveal-ask;
                        focus-list => { keys.focus(); }
                        reveal(y, h) => {
                            if root.reveal-pending {
                                root.reveal-pending = false;
                                list.ensure-visible(y, h);
                            }
                        }
                    }
                }
            }
        }
    }
}
