import { ListView, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

export { Theme }

export struct TaskItem {
    id: int,
    name: string,
    tag: string,
    status: string,
    state: int, // 0 done, 1 downloading, 2 paused, 3 failed, 4 waiting
    size: string,
    progress: float,
    speed: string,
    left: string,
    header: string,
    header-icon: string,
    header-count: int,
    header-kind: int, // 0 downloading, 1 waiting, 2 paused & failed, 3 completed
}

export struct NavEntry {
    label: string,
    count: int,
}

export component Tray inherits SystemTrayIcon {
    icon: @image-url("logo.png");
    in property <string> tip: "FetchJet - Running in Background";
    tooltip: root.tip;
    callback show-app();
    callback quit-app();
    clicked => { root.show-app(); }
    Menu {
        MenuItem { title: "Show App"; activated => { root.show-app(); } }
        MenuSeparator { }
        MenuItem { title: "Close App"; activated => { root.quit-app(); } }
    }
}

component GlyphIcon inherits Path {
    in property <int> kind; // 0 search, 1 sun, 2 moon, 3 chevron down
    in property <color> tint;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.kind == 2 ? transparent : root.tint;
    stroke-width: 2px;
    fill: root.kind == 2 ? root.tint : transparent;
    commands: root.kind == 0 ? "M 10.5 4 A 6.5 6.5 0 1 0 10.5 17 A 6.5 6.5 0 1 0 10.5 4 Z M 15.5 15.5 L 20.5 20.5"
        : root.kind == 1 ? "M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8 Z M 12 2 L 12 4.5 M 12 19.5 L 12 22 M 2 12 L 4.5 12 M 19.5 12 L 22 12 M 4.9 4.9 L 6.7 6.7 M 17.3 17.3 L 19.1 19.1 M 4.9 19.1 L 6.7 17.3 M 17.3 6.7 L 19.1 4.9"
        : root.kind == 2 ? "M 20 14.5 A 8.5 8.5 0 1 1 9.5 4 A 6.8 6.8 0 0 0 20 14.5 Z"
        : "M 7 10 L 12 15 L 17 10";
}

component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> selected;
    in property <bool> show-count: true;
    callback clicked();
    height: 38px;
    border-radius: 9px;
    background: selected ? Theme.on-surface.with-alpha(0.08) : (ta.has-hover ? Theme.on-surface.with-alpha(0.04) : transparent);
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.label;
            color: root.selected ? Theme.on-surface : Theme.on-surface-variant;
            font-size: 14px;
            font-weight: root.selected ? 600 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.show-count: VerticalLayout {
            alignment: center;
            Rectangle {
                width: max(24px, cnt.preferred-width + 14px);
                height: 18px;
                border-radius: 9px;
                background: root.selected ? Theme.primary : Theme.on-surface.with-alpha(0.07);
                cnt := Text {
                    text: root.count;
                    color: root.selected ? Theme.on-primary : Theme.on-surface-variant;
                    font-size: 11px;
                    font-weight: 700;
                }
            }
        }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <length> button-height: 44px;
    callback clicked();
    height: root.button-height;
    min-width: lbl.preferred-width + 36px;
    border-radius: 12px;
    background: ta.pressed ? Theme.primary.darker(0.2) : (ta.has-hover ? Theme.primary.brighter(0.1) : Theme.primary);
    lbl := Text { text: root.text; color: Theme.on-primary; font-size: 14px; font-weight: 700; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component OutlineButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px;
    min-width: lbl.preferred-width + 24px;
    border-radius: 10px;
    background: root.active ? Theme.primary : (ta.has-hover && root.enabled ? Theme.on-surface.with-alpha(0.05) : transparent);
    border-width: 1px;
    border-color: root.active ? Theme.primary : Theme.outline;
    opacity: root.enabled ? 1 : 0.45;
    lbl := Text {
        text: root.text;
        color: root.active ? Theme.on-primary : Theme.primary;
        font-size: 12px;
        font-weight: 600;
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component CheckMark inherits Rectangle {
    in-out property <bool> checked;
    width: 24px;
    height: 24px;
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 3px;
        border-width: root.checked ? 0 : 2px;
        border-color: Theme.on-surface-variant;
        background: root.checked ? Theme.primary : transparent;
        if root.checked: Text { text: "✓"; color: Theme.on-primary; font-size: 12px; font-weight: 800; }
    }
    TouchArea { clicked => { root.checked = !root.checked; } }
}

component ThinBar inherits Rectangle {
    in property <float> value;
    in property <color> fill;
    height: 5px;
    border-radius: 3px;
    background: Theme.on-surface.with-alpha(0.08);
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        height: parent.height;
        border-radius: 3px;
        background: root.fill;
    }
}

component KindSquare inherits Rectangle {
    in property <string> tag;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: Theme.on-surface.with-alpha(0.06);
    Text {
        text: root.tag;
        font-size: 9px;
        font-weight: 800;
        color: root.tag == "VID" ? #C4B5FD
            : root.tag == "AUD" ? #6EE7B7
            : root.tag == "MAG" ? #F9A8D4
            : (root.tag == "ZIP" || root.tag == "RAR" || root.tag == "7Z") ? #FCD34D
            : (root.tag == "ISO" || root.tag == "IMG" || root.tag == "DMG") ? #93C5FD
            : (root.tag == "EXE" || root.tag == "MSI" || root.tag == "APK") ? #FDBA74
            : #B7C0D8;
    }
}

component PriorityChip inherits Rectangle {
    height: 22px;
    width: lbl.preferred-width + 14px;
    border-radius: 6px;
    background: Theme.on-surface-variant.with-alpha(0.15);
    border-width: 1px;
    border-color: Theme.on-surface-variant.with-alpha(0.4);
    lbl := Text { text: "Normal"; color: Theme.on-surface-variant; font-size: 10px; font-weight: 600; }
}

component QuickAction inherits Rectangle {
    in property <int> state;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 17px;
    border-width: 1px;
    border-color: Theme.outline-variant.with-alpha(0.7);
    background: ta.has-hover ? Theme.on-surface.with-alpha(0.06) : transparent;
    Text {
        text: root.state == 1 ? "⏸" : (root.state == 0 ? "↗" : "▶");
        color: Theme.on-surface;
        font-size: 13px;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component SectionHeader inherits HorizontalLayout {
    in property <string> icon;
    in property <string> title;
    in property <int> count;
    in property <int> kind;
    property <color> tint: root.kind == 0 ? Theme.primary
        : root.kind == 1 ? Theme.on-surface-variant
        : root.kind == 2 ? Theme.status-paused
        : Theme.tertiary;
    padding-top: 6px;
    padding-bottom: 4px;
    spacing: 6px;
    height: 34px;
    Text { text: "▼"; color: root.tint; font-size: 11px; vertical-alignment: center; }
    Text { text: root.icon; color: root.tint; font-size: 14px; vertical-alignment: center; }
    Text { text: root.title; color: root.tint; font-size: 14px; font-weight: 700; vertical-alignment: center; }
    VerticalLayout {
        alignment: center;
        padding-left: 2px;
        Rectangle {
            height: 20px;
            width: num.preferred-width + 16px;
            border-radius: 10px;
            background: root.tint.with-alpha(0.15);
            num := Text { text: root.count; color: root.tint; font-size: 11px; font-weight: 700; }
        }
    }
    VerticalLayout {
        alignment: center;
        padding-left: 4px;
        horizontal-stretch: 1;
        Rectangle { height: 1px; background: Theme.outline-variant.with-alpha(0.5); }
    }
}

component TaskRow inherits Rectangle {
    in property <TaskItem> task;
    callback toggle();
    height: 54px;
    border-radius: 12px;
    background: ta.has-hover ? Theme.surface.mix(Theme.on-surface, 0.97) : Theme.surface;
    border-width: 1px;
    border-color: Theme.outline-variant.with-alpha(0.35);
    ta := TouchArea { }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: stretch;
        VerticalLayout { alignment: center; CheckMark { } }
        VerticalLayout { alignment: center; KindSquare { tag: root.task.tag; } }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.task.name; color: Theme.on-surface; font-size: 13px; font-weight: 600; overflow: elide; }
            Text {
                text: root.task.status;
                color: root.task.state == 3 ? Theme.error : Theme.on-surface-variant;
                font-size: 11px;
                overflow: elide;
            }
        }
        Text { text: root.task.size; color: Theme.on-surface-variant; width: 76px; font-size: 12px; vertical-alignment: center; }
        VerticalLayout {
            width: 140px;
            alignment: center;
            spacing: 3px;
            ThinBar {
                value: root.task.progress;
                fill: root.task.state == 3 ? Theme.error
                    : root.task.state == 0 ? Theme.completed
                    : (root.task.state == 2 || root.task.state == 4) ? Theme.paused
                    : Theme.primary;
            }
            Text { text: root.task.state == 0 ? "100%" : floor(root.task.progress * 100) + "%"; color: Theme.on-surface-variant; font-size: 11px; }
        }
        Text { text: root.task.speed; color: Theme.on-surface; width: 84px; font-size: 12px; font-weight: 600; vertical-alignment: center; }
        Text { text: root.task.left; color: Theme.on-surface-variant; width: 64px; font-size: 12px; vertical-alignment: center; }
        if root.task.state != 0: VerticalLayout { alignment: center; PriorityChip { } }
        VerticalLayout { alignment: center; QuickAction { state: root.task.state; clicked => { root.toggle(); } } }
    }
}

component SearchField inherits Rectangle {
    in-out property <string> text;
    height: 44px;
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.primary : Theme.outline-variant;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout { alignment: center; GlyphIcon { kind: 0; tint: Theme.on-surface-variant; } }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                text <=> root.text;
                color: Theme.on-surface;
                font-size: 14px;
                vertical-alignment: center;
                single-line: true;
            }
            if root.text == "": Text {
                x: 0;
                text: "Search downloads";
                color: Theme.on-surface-variant;
                font-size: 14px;
                vertical-alignment: center;
                height: parent.height;
            }
        }
    }
}

component AddDialog inherits Rectangle {
    callback cancel();
    callback start-download(string, int);
    in-out property <string> url;
    in-out property <int> engine: 0;
    background: #000000a0;
    TouchArea { clicked => { root.cancel(); } }
    Rectangle {
        width: 560px;
        height: 380px;
        border-radius: 18px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.outline-variant;
        TouchArea { }
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            Text { text: "Add New Download"; color: Theme.on-surface; font-size: 22px; font-weight: 800; }
            Text { text: "Enter link to start downloading"; color: Theme.on-surface-variant; font-size: 13px; }
            Text { text: "Link"; color: Theme.on-surface; font-size: 13px; font-weight: 700; }
            LineEdit { placeholder-text: "Paste links or magnets"; text <=> root.url; }
            Text { text: "Download Engine"; color: Theme.on-surface; font-size: 13px; font-weight: 700; }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                OutlineButton { text: "⚡ Direct"; active: root.engine == 0; clicked => { root.engine = 0; } }
                OutlineButton { text: "🎬 Media"; active: root.engine == 1; clicked => { root.engine = 1; } }
                OutlineButton { text: "🧲 Torrent"; active: root.engine == 2; clicked => { root.engine = 2; } }
            }
            Rectangle { }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                OutlineButton { text: "Cancel"; clicked => { root.cancel(); } }
                PrimaryButton { text: "Start Download"; button-height: 40px; clicked => { root.start-download(root.url, root.engine); } }
            }
        }
    }
}

component SettingsPage inherits Rectangle {
    in-out property <int> page: 0;
    property <[string]> pages: ["General", "Downloads", "Browser extension", "Devices", "Network", "Media tools", "BitTorrent", "Updates"];
    HorizontalLayout {
        spacing: 20px;
        VerticalLayout {
            width: 240px;
            spacing: 2px;
            alignment: start;
            for p[i] in root.pages: SidebarItem {
                label: p;
                show-count: false;
                selected: root.page == i;
                clicked => { root.page = i; }
            }
        }
        Rectangle {
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.outline-variant;
            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                alignment: start;
                Text { text: root.pages[root.page]; color: Theme.on-surface; font-size: 22px; font-weight: 800; }
                if root.page == 0: HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Appearance"; color: Theme.on-surface; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                    Rectangle { }
                    OutlineButton { text: "Light"; active: !Theme.dark; clicked => { Theme.dark = false; } }
                    OutlineButton { text: "Dark"; active: Theme.dark; clicked => { Theme.dark = true; } }
                }
                if root.page != 0: Text {
                    text: "Coming in the native build.";
                    color: Theme.on-surface-variant;
                    font-size: 13px;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "FetchJet - High-Velocity Multi-Engine Downloader";
    icon: @image-url("logo.png");
    preferred-width: 1200px;
    preferred-height: 660px;
    min-width: 900px;
    min-height: 500px;
    background: Theme.background;
    default-font-family: "Segoe UI";

    in property <[TaskItem]> tasks;
    in property <[NavEntry]> nav;
    in property <string> down-speed: "0 B/s";
    in property <string> up-speed: "0 B/s";
    in property <string> limit-text: "";
    in property <bool> limited;
    in property <string> summary: "";
    in property <string> queue-text: "";
    in property <string> limit-status: "";
    in property <string> version: "";
    in property <bool> any-pausable;
    in property <bool> any-resumable;
    in-out property <string> search;
    in-out property <int> filter: 0;
    in-out property <bool> show-settings: false;
    in-out property <bool> show-add: false;
    callback filter-changed(int);
    callback add-download(string, int);
    callback toggle-task(int);
    callback pause-all();
    callback resume-all();

    HorizontalLayout {
        Rectangle {
            width: 232px;
            background: Theme.background.mix(Theme.surface-variant, 0.7);
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 2px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-bottom: 18px;
                    spacing: 10px;
                    Image { source: @image-url("logo.svg"); width: 32px; height: 32px; }
                    Text { text: "FetchJet"; color: Theme.on-surface; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                }
                for n[i] in root.nav: VerticalLayout {
                    if i == 6: VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        Rectangle { height: 1px; background: Theme.outline-variant.with-alpha(0.4); }
                    }
                    if i == 6: Text {
                        text: "TYPE";
                        color: Theme.on-surface-variant;
                        font-size: 11px;
                        font-weight: 700;
                        x: 10px;
                        height: 20px;
                    }
                    SidebarItem {
                        label: n.label;
                        count: n.count;
                        selected: !root.show-settings && root.filter == i;
                        clicked => {
                            root.show-settings = false;
                            root.filter = i;
                            root.filter-changed(i);
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                SidebarItem {
                    label: "Settings";
                    show-count: false;
                    selected: root.show-settings;
                    clicked => { root.show-settings = true; }
                }
            }
        }
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                if !root.show-settings: SearchField { text <=> root.search; horizontal-stretch: 1; }
                if root.show-settings: Text {
                    text: "Settings";
                    color: Theme.on-surface;
                    font-size: 24px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 38px;
                        width: speeds.preferred-width;
                        border-radius: 12px;
                        background: Theme.surface-variant.with-alpha(0.45);
                        speeds := HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            Text { text: "↓ " + root.down-speed; color: Theme.primary; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                            Text { text: "↑ " + root.up-speed; color: Theme.on-surface-variant; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 4px;
                        Rectangle {
                            width: 38px;
                            height: 34px;
                            border-radius: 10px;
                            background: root.limited ? Theme.primary.with-alpha(0.22) : transparent;
                            Text { text: "🐢"; font-size: 18px; color: Theme.on-surface; }
                        }
                        Rectangle {
                            height: 34px;
                            width: chip.preferred-width;
                            border-radius: 10px;
                            background: root.limited ? Theme.primary.with-alpha(0.18) : Theme.surface-variant.with-alpha(0.4);
                            chip := HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 9px;
                                Text {
                                    text: root.limit-text;
                                    color: root.limited ? Theme.primary : Theme.on-surface-variant;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                VerticalLayout { alignment: center; padding-left: 2px; GlyphIcon { kind: 3; tint: Theme.on-surface-variant; width: 14px; height: 14px; } }
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: th.has-hover ? Theme.on-surface.with-alpha(0.06) : transparent;
                        GlyphIcon { kind: Theme.dark ? 1 : 2; tint: Theme.dark ? Theme.paused : Theme.on-surface-variant; width: 20px; height: 20px; }
                        th := TouchArea { clicked => { Theme.dark = !Theme.dark; } }
                    }
                }
                PrimaryButton { text: "+  Add"; clicked => { root.show-add = true; } }
            }
            if root.show-settings: SettingsPage { vertical-stretch: 1; }
            if !root.show-settings: VerticalLayout {
                spacing: 6px;
                vertical-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    padding-bottom: 2px;
                    OutlineButton { text: "⏸  Pause all"; enabled: root.any-pausable; clicked => { root.pause-all(); } }
                    OutlineButton { text: "▶  Resume all"; enabled: root.any-resumable; clicked => { root.resume-all(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "Sort: Newest first"; color: Theme.primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                    VerticalLayout { alignment: center; GlyphIcon { kind: 3; tint: Theme.primary; width: 14px; height: 14px; } }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    height: 26px;
                    CheckMark { }
                    Rectangle { width: 34px; }
                    Text { text: "NAME"; color: Theme.on-surface-variant; font-size: 11px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: "SIZE"; color: Theme.on-surface-variant; font-size: 11px; font-weight: 700; width: 76px; vertical-alignment: center; }
                    Text { text: "PROGRESS"; color: Theme.on-surface-variant; font-size: 11px; font-weight: 700; width: 140px; vertical-alignment: center; }
                    Text { text: "SPEED"; color: Theme.on-surface-variant; font-size: 11px; font-weight: 700; width: 84px; vertical-alignment: center; }
                    Text { text: "LEFT"; color: Theme.on-surface-variant; font-size: 11px; font-weight: 700; width: 64px; vertical-alignment: center; }
                    Rectangle { width: 34px; }
                }
                Rectangle {
                    vertical-stretch: 1;
                    ListView {
                        width: parent.width;
                        height: parent.height;
                        for t in root.tasks: VerticalLayout {
                            padding-bottom: 6px;
                            if t.header != "": SectionHeader {
                                icon: t.header-icon;
                                title: t.header;
                                count: t.header-count;
                                kind: t.header-kind;
                            }
                            TaskRow { task: t; toggle => { root.toggle-task(t.id); } }
                        }
                    }
                    if root.tasks.length == 0: VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        alignment: center;
                        spacing: 8px;
                        Text { text: "📥"; font-size: 48px; horizontal-alignment: center; color: Theme.on-surface-variant; }
                        Text { text: "No downloads here yet"; font-size: 14px; horizontal-alignment: center; color: Theme.on-surface-variant; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 18px;
                padding-top: 6px;
                Text { text: root.summary; color: Theme.on-surface-variant; font-size: 12px; font-weight: 500; }
                Text { text: root.queue-text; color: Theme.on-surface-variant; font-size: 12px; font-weight: 500; }
                Text { text: root.limit-status; color: Theme.on-surface-variant; font-size: 12px; font-weight: 500; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.version; color: Theme.on-surface-variant; font-size: 12px; font-weight: 500; }
            }
        }
    }

    if root.show-add: AddDialog {
        width: root.width;
        height: root.height;
        cancel => { root.show-add = false; }
        start-download(url, engine) => {
            root.show-add = false;
            root.add-download(url, engine);
        }
    }
}
