import { Theme, Dir } from "theme.slint";
import { Emoji } from "widgets/Icons.slint";
import { Screen } from "widgets/Menu.slint";
import { Sidebar } from "pages/Sidebar.slint";
import { Rail } from "pages/Rail.slint";
import { TopBar } from "pages/TopBar.slint";
import { TaskList } from "pages/TaskList.slint";
import { StatusBar } from "pages/StatusBar.slint";
import { DetailsPane } from "pages/Details.slint";
import { Alerts, Toast } from "pages/Alerts.slint";
import { AddDialog } from "pages/AddDialog.slint";
import { ChoiceDialogs, ClipPickerDialog } from "pages/ChoiceDialogs.slint";
import { SettingsPanel } from "pages/Settings.slint";
import { UpdateDialog } from "pages/UpdateDialog.slint";
import { AudioCompressDialog } from "pages/AudioCompress.slint";
import { DeviceSheet, PairingDialog } from "pages/DeviceSheet.slint";
import { PairingCode } from "generated/dto.slint";
import { Core } from "generated/dto.slint";
import { Tr } from "generated/tr.slint";
import { Act } from "generated/actions.slint";
export * from "generated/dto.slint";
export { Theme, Dir, Tr, Act, Emoji }

component DetailsSheet inherits Rectangle {
    in-out property <bool> expanded: false;
    background: #00000099;
    TouchArea {
        clicked => { Act.closeDetails(); }
    }
    Rectangle {
        y: parent.height - self.height;
        height: root.expanded ? parent.height * 0.94 : min(parent.height * 0.9, 25px + pane.wanted-height);
        background: Theme.background;
        border-top-left-radius: 22px;
        border-top-right-radius: 22px;
        clip: true;
        TouchArea { }
        Rectangle {
            y: 0;
            height: 25px;
            handle := TouchArea {
                clicked => { root.expanded = !root.expanded; }
            }
            Rectangle {
                y: 12px;
                width: 44px;
                height: 5px;
                border-radius: 3px;
                background: Theme.on-surface.with-alpha(0.18);
            }
        }
        pane := DetailsPane {
            y: 25px;
            height: parent.height - 25px;
            surface: Theme.background;
        }
    }
}

export component AppWindow inherits Window {
    private property <bool> medium: root.width < 1100px;
    private property <bool> side-panel: root.width >= 1280px;
    private property <bool> details-side: root.side-panel && Core.chrome.detailsOpen;
    private property <length> nav: root.medium ? 84px : 232px;
    private property <length> panel: root.details-side ? 340px : 0px;
    public function scroll-to-top() {
        list.scroll-to-top();
    }
    init => { Screen.height = root.height; }
    changed height => { Screen.height = root.height; }
    preferred-width: 1100px;
    preferred-height: 750px;
    min-width: 680px;
    min-height: 480px;
    background: Theme.background;
    title: Core.shell.windowTitle;
    icon: @image-url("logo.png");

    if root.medium: Rail {
        x: Dir.rtl ? parent.width - self.width : 0;
        height: parent.height;
    }
    if !root.medium: Sidebar {
        x: Dir.rtl ? parent.width - self.width : 0;
        height: parent.height;
    }
    Rectangle {
        x: Dir.rtl ? root.panel + 16px : root.nav + 16px;
        y: 10px;
        width: parent.width - root.nav - root.panel - 32px;
        height: parent.height - 20px;
        VerticalLayout {
            spacing: 0px;
            TopBar {
                compact: root.medium;
            }
            list := TaskList {
                vertical-stretch: 1;
                visible: !Core.chrome.settingsOpen;
            }
            StatusBar {
                visible: !Core.chrome.settingsOpen;
            }
        }
        if Core.chrome.settingsOpen: SettingsPanel {
            y: 58px;
            height: parent.height - 58px;
        }
    }
    if root.details-side: Rectangle {
        x: Dir.rtl ? 0 : parent.width - 340px;
        width: 340px;
        height: parent.height;
        DetailsPane {
            x: Dir.rtl ? 0 : 1px;
            width: 339px;
        }
        Rectangle {
            x: Dir.rtl ? 339px : 0;
            width: 1px;
            background: Theme.outline-variant.with-alpha(0.4);
        }
    }
    if !root.side-panel && Core.chrome.detailsOpen: DetailsSheet { }
    Toast {
        y: parent.height - (!root.side-panel && Core.chrome.detailsOpen ? 24px : 88px) - self.height;
        visible: Core.shell.toastText != "";
    }
    if Core.add.visible: AddDialog { }
    if Core.clipPicker.open: ClipPickerDialog { }
    if Core.deviceSheet.open: DeviceSheet { }
    if Core.devicePairing.state != PairingCode.none: PairingDialog { }
    if Core.audioCompress.open: AudioCompressDialog { }
    if Core.updateDialog.open: UpdateDialog { }
    Alerts { }
    ChoiceDialogs { }
}
