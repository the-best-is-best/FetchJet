import { Theme, Dir } from "../theme.slint";
import { Hover } from "Base.slint";
import { MenuOptionDto, RowMenuItemDto } from "../generated/dto.slint";

export component OptionsMenu inherits PopupWindow {
    in property <[MenuOptionDto]> options;
    in property <length> font-size: 14px;
    in property <bool> check-first: false;
    callback picked(index: int);
    close-policy: PopupClosePolicy.close-on-click-outside;
    forward-focus: keys;
    Rectangle {
        background: Theme.surface-container;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.outline-variant.with-alpha(0.6);
    }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.close();
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            for option[i] in root.options: Rectangle {
                height: 48px;
                accessible-role: button;
                accessible-label: option.label;
                accessible-checkable: option.checked;
                accessible-checked: option.checked;
                accessible-action-default => {
                    root.picked(i);
                    root.close();
                }
                min-width: 112px;
                max-width: 280px;
                ta := TouchArea {
                    clicked => {
                        root.picked(i);
                        root.close();
                    }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 0px;
                    if root.check-first && !Dir.rtl: Text {
                        width: 24px;
                        text: option.checked ? "✓" : "";
                        color: Theme.on-surface;
                        font-family: Theme.symbol-font;
                        font-size: root.font-size;
                        vertical-alignment: center;
                    }
                    if !root.check-first && Dir.rtl: Text {
                        width: 28px;
                        text: option.checked ? "✓" : "";
                        color: Theme.on-surface;
                        font-family: Theme.symbol-font;
                        font-size: root.font-size;
                        vertical-alignment: center;
                    }
                    Text {
                        text: option.label;
                        color: Theme.on-surface;
                        font-family: Theme.font;
                        font-size: root.font-size;
                        font-weight: 500;
                        letter-spacing: Dir.rtl ? 0px : 0.1px;
                        vertical-alignment: center;
                        horizontal-alignment: Dir.start;
                        horizontal-stretch: 1;
                    }
                    if root.check-first && Dir.rtl: Text {
                        width: 24px;
                        text: option.checked ? "✓" : "";
                        color: Theme.on-surface;
                        font-family: Theme.symbol-font;
                        font-size: root.font-size;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                    if !root.check-first && !Dir.rtl: Text {
                        width: 28px;
                        text: option.checked ? "✓" : "";
                        color: Theme.on-surface;
                        font-family: Theme.symbol-font;
                        font-size: root.font-size;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
                Hover {
                    ink: Theme.on-surface;
                    hovered: ta.has-hover;
                    pressed: ta.pressed;
                }
            }
        }
    }
}

export global Screen {
    in-out property <length> height: 750px;
}

export component PickMenu inherits PopupWindow {
    in property <[string]> options;
    in property <int> pick;
    in property <length> font-size: 14px;
    in property <length> anchor-top;
    in property <length> anchor-height;
    in property <int> han: 0;
    private property <length> tall: min(root.options.length * 48px + 16px, max(160px, Screen.height - 96px));
    callback picked(index: int);
    y: (root.anchor-top + root.anchor-height + root.tall <= Screen.height - 48px ? root.anchor-top + root.anchor-height
        : root.anchor-top - root.tall >= 48px ? root.anchor-top - root.tall
        : root.anchor-top + root.anchor-height / 2 < Screen.height / 2 ? 48px
        : Screen.height - 48px - root.tall) - root.anchor-top;
    width: clamp(measure.preferred-width + 24px, 112px, 280px);
    height: root.tall;
    close-policy: PopupClosePolicy.close-on-click-outside;
    forward-focus: keys;
    Rectangle {
        background: Theme.surface-container;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.outline-variant.with-alpha(0.6);
    }
    measure := VerticalLayout {
        visible: false;
        for option in root.options: Text {
            text: option;
            font-family: Theme.font;
            font-size: root.font-size;
            font-weight: 700;
        }
    }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.close();
                return accept;
            }
            reject
        }
        Flickable {
            content-width: self.width;
            content-height: root.options.length * 48px + 16px;
            for option[i] in root.options: Rectangle {
                x: 0;
                y: 8px + i * 48px;
                width: parent.width;
                height: 48px;
                accessible-role: button;
                accessible-label: option;
                accessible-action-default => {
                    root.picked(i);
                    root.close();
                }
                tap := TouchArea {
                    clicked => {
                        root.picked(i);
                        root.close();
                    }
                }
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: option;
                    color: i + 1 == root.pick ? Theme.primary : Theme.on-surface;
                    font-family: i + 1 == root.han ? "Microsoft YaHei UI" : Theme.font;
                    font-size: root.font-size;
                    font-weight: i + 1 == root.pick ? 700 : 400;
                    letter-spacing: Dir.rtl ? 0px : 0.1px;
                    horizontal-alignment: Dir.start;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Hover {
                    hovered: tap.has-hover;
                    pressed: tap.pressed;
                }
            }
        }
    }
}

export component RowMenuPopup inherits PopupWindow {
    in property <[RowMenuItemDto]> items;
    private property <bool> compact: Screen.height < 640px;
    private property <length> row-h: root.compact ? 32px : 38px;
    private property <length> head-h: root.compact ? 20px : 24px;
    private property <int> current: -1;
    out property <length> tall: min(list.preferred-height, Screen.height - 24px);
    callback picked(key: int);
    width: clamp(measure.preferred-width + 40px, 180px, 300px);
    height: root.tall;
    close-policy: PopupClosePolicy.close-on-click-outside;
    forward-focus: keys;
    pure function wrap(i: int) -> int {
        i < 0 ? root.items.length - 1 : i >= root.items.length ? 0 : i
    }
    function step(d: int) {
        if root.items.length == 0 {
            return;
        }
        root.current = root.wrap(root.current < 0 && d < 0 ? -1 : root.current + d);
        if root.items[root.current].disabled {
            root.current = root.wrap(root.current + d);
        }
    }
    function choose() {
        if root.current >= 0 && root.current < root.items.length && !root.items[root.current].disabled {
            root.picked(root.items[root.current].key);
            root.close();
        }
    }
    Rectangle {
        background: Theme.surface-container;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.outline-variant.with-alpha(0.6);
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;
    }
    measure := VerticalLayout {
        visible: false;
        for item in root.items: VerticalLayout {
            Text {
                text: item.label;
                font-family: Theme.font;
                font-size: 14px;
                font-weight: 500;
            }
            Text {
                text: item.header;
                font-family: Theme.font;
                font-size: 11px;
                font-weight: 600;
            }
        }
    }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.close();
                return accept;
            }
            if e.text == Key.DownArrow || e.text == Key.Tab {
                root.step(1);
                return accept;
            }
            if e.text == Key.UpArrow || e.text == Key.Backtab {
                root.step(-1);
                return accept;
            }
            if e.text == Key.Home {
                root.current = -1;
                root.step(1);
                return accept;
            }
            if e.text == Key.End {
                root.current = 0;
                root.step(-1);
                return accept;
            }
            if e.text == Key.Return || e.text == " " {
                root.choose();
                return accept;
            }
            reject
        }
        flick := Flickable {
            content-width: self.width;
            content-height: list.preferred-height;
            list := VerticalLayout {
                width: flick.width;
                padding-top: 6px;
                padding-bottom: 6px;
                for item[i] in root.items: VerticalLayout {
                    if item.divider: Rectangle {
                        height: 9px;
                        Rectangle {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 1px;
                            background: Theme.outline-variant.with-alpha(0.5);
                        }
                    }
                    if item.header != "": Rectangle {
                        height: root.head-h;
                        Text {
                            x: 16px;
                            width: parent.width - 32px;
                            text: item.header;
                            color: Theme.on-surface-variant;
                            font-family: Theme.font;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: Dir.rtl ? 0px : 0.5px;
                            horizontal-alignment: Dir.start;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    cell := Rectangle {
                        private property <bool> on: i == root.current;
                        private property <length> top: parent.y + self.y;
                        changed on => {
                            if self.on && self.top + flick.content-y < 0px {
                                flick.content-y = -self.top;
                            } else if self.on && self.top + self.height + flick.content-y > flick.height {
                                flick.content-y = flick.height - self.top - self.height;
                            }
                        }
                        height: root.row-h;
                        accessible-role: button;
                        accessible-label: item.label;
                        accessible-enabled: !item.disabled;
                        accessible-action-default => {
                            if !item.disabled {
                                root.picked(item.key);
                                root.close();
                            }
                        }
                        ta := TouchArea {
                            enabled: !item.disabled;
                            changed has-hover => {
                                if self.has-hover {
                                    root.current = i;
                                } else if root.current == i {
                                    root.current = -1;
                                }
                            }
                            clicked => {
                                root.picked(item.key);
                                root.close();
                            }
                        }
                        Text {
                            x: 16px;
                            width: parent.width - 32px;
                            text: item.label;
                            color: item.disabled ? Theme.on-surface-variant.with-alpha(0.6) : item.danger ? Theme.error : Theme.on-surface;
                            font-family: Theme.font;
                            font-size: 14px;
                            font-weight: 500;
                            letter-spacing: Dir.rtl ? 0px : 0.1px;
                            horizontal-alignment: Dir.start;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Hover {
                            ink: item.danger ? Theme.error : Theme.on-surface;
                            hovered: cell.on && !item.disabled;
                            pressed: ta.pressed;
                        }
                    }
                }
            }
        }
    }
}
