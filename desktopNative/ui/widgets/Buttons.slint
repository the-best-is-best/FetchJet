import { Theme, Dir } from "../theme.slint";
import { Hover, HBox } from "Base.slint";

export component FilledButton inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <string> trail;
    in property <bool> enabled: true;
    in property <length> pad: 24px;
    in property <length> font-size: 14px;
    in property <int> font-weight: 500;
    in property <color> container: Theme.primary;
    in property <color> ink: Theme.on-primary;
    callback clicked();
    height: 40px;
    min-width: max(58px, content.preferred-width + 2 * root.pad);
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: root.enabled ? root.container : Theme.on-surface.with-alpha(0.1);
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    content := HBox {
        x: (parent.width - self.preferred-width) / 2;
        width: self.preferred-width;
        spacing: 0px;
        cross-axis-alignment: center;
        if root.glyph != "": Text {
            text: root.glyph;
            width: self.preferred-width + 8px;
            color: root.enabled ? root.ink : Theme.on-surface-variant.with-alpha(0.38);
            font-family: "Segoe UI Symbol";
            font-size: root.font-size;
            horizontal-alignment: Dir.start;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: root.enabled ? root.ink : Theme.on-surface-variant.with-alpha(0.38);
            font-family: Theme.font;
            font-size: root.font-size;
            font-weight: root.font-weight;
            letter-spacing: Dir.rtl ? 0px : 0.1px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.trail != "": Text {
            text: root.trail;
            width: self.preferred-width + 8px;
            color: root.enabled ? root.ink : Theme.on-surface-variant.with-alpha(0.38);
            font-family: "Segoe UI Symbol";
            font-size: root.font-size;
            horizontal-alignment: Dir.end;
            vertical-alignment: center;
        }
    }
    Hover {
        border-radius: root.border-radius;
        ink: root.ink;
        hovered: ta.has-hover && root.enabled;
        pressed: ta.pressed && root.enabled;
    }
}

export component OutlinedButton inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <string> trail;
    in property <bool> enabled: true;
    in property <length> pad: 24px;
    in property <length> font-size: 14px;
    in property <int> font-weight: 500;
    in property <color> ink: Theme.on-surface-variant;
    in property <color> line: Theme.outline-variant;
    callback clicked();
    height: 40px;
    min-width: max(58px, content.preferred-width + 2 * root.pad);
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: root.enabled ? root.line : root.line.with-alpha(0.1);
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    content := HBox {
        x: (parent.width - self.preferred-width) / 2;
        width: self.preferred-width;
        spacing: 0px;
        cross-axis-alignment: center;
        if root.glyph != "": Text {
            text: root.glyph;
            width: self.preferred-width + 8px;
            color: root.enabled ? root.ink : root.ink.with-alpha(0.38);
            font-family: "Segoe UI Symbol";
            font-size: root.font-size;
            horizontal-alignment: Dir.start;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: root.enabled ? root.ink : root.ink.with-alpha(0.38);
            font-family: Theme.font;
            font-size: root.font-size;
            font-weight: root.font-weight;
            letter-spacing: Dir.rtl ? 0px : 0.1px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.trail != "": Text {
            text: root.trail;
            width: self.preferred-width + 8px;
            color: root.enabled ? root.ink : root.ink.with-alpha(0.38);
            font-family: "Segoe UI Symbol";
            font-size: root.font-size;
            horizontal-alignment: Dir.end;
            vertical-alignment: center;
        }
    }
    Hover {
        border-radius: root.border-radius;
        ink: root.ink;
        hovered: ta.has-hover && root.enabled;
        pressed: ta.pressed && root.enabled;
    }
}

export component TextButton inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
