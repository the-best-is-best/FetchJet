        border-radius: root.border-radius;
        ink: root.ink;
        hovered: ta.has-hover && root.enabled;
        pressed: ta.pressed && root.enabled;
    }
}

export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    in property <length> size: 48px;
    in property <length> circle: min(40px, root.size);
    in property <length> glyph-size: 18px;
    in property <int> glyph-weight: 400;
    in property <color> ink: Theme.on-background;
    in property <string> glyph-font: "Segoe UI Symbol";
    out property <bool> has-hover: ta.has-hover;
    callback clicked();
    width: root.size;
    height: root.size;
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Hover {
        width: root.circle;
        height: root.circle;
        border-radius: root.circle / 2;
        ink: root.ink;
        hovered: ta.has-hover && root.enabled;
        pressed: ta.pressed && root.enabled;
    }
    if root.glyph != "": Text {
        text: root.glyph;
        color: root.enabled ? root.ink : root.ink.with-alpha(0.38);
        font-family: root.glyph-font;
        font-size: root.glyph-size;
        font-weight: root.glyph-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    @children
}
