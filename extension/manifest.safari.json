{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "3.4.0",
  "description": "__MSG_extDescriptionSafari__",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "cookies",
    "webRequest",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "i18n/i18n.js",
        "i18n/en.js",
        "i18n/ar.js",
        "i18n/fr.js",
        "i18n/de.js",
        "i18n/es.js",
        "i18n/pt.js",
        "i18n/it.js",
        "i18n/ru.js",
        "i18n/tr.js",
        "i18n/id.js",
        "i18n/zh.js",
        "i18n/ja.js",
        "i18n/ko.js",
        "i18n/hi.js",
        "i18n/fa.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FetchJet",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  }
}
