    </path>

    <!-- Supersonic Shockwave Arc -->
    <path android:pathData="M 34,80 C 45,89 63,89 74,80 L 76,82 C 64,92 44,92 32,82 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="76"
                android:endY="92"
                android:startX="32"
                android:startY="80"
                android:type="linear">
                <item
                    android:color="#FF00E5FF"
                    android:offset="0.0" />
                <item
                    android:color="#FF818CF8"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
