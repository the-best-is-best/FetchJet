<?xml version="1.0" encoding="utf-8"?><!-- Android 12+: the same files stay out of cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="settings/network.json" />
        <exclude
            domain="file"
            path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="settings/network.json" />
        <exclude
            domain="file"
            path="logs/" />
    </device-transfer>
</data-extraction-rules>
