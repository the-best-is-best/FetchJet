<?xml version="1.0" encoding="utf-8"?><!-- Android 6-11 backups: no saved passwords (network.json) or logs. The task list stays out too: its links and cookies are encrypted with a Keystore key, which is never in a backup, so a restored list could not be read. -->
<full-backup-content>
    <exclude
        domain="file"
        path="settings/tasks_cache.json" />
    <exclude
        domain="file"
        path="settings/network.json" />
    <exclude
        domain="file"
        path="logs/" />
    <exclude
        domain="file"
        path="settings/hidden.json" />
    <exclude
        domain="file"
        path="settings/hidden.json.bak" />
    <exclude
        domain="file"
        path="settings/hidden.json.bad" />
    <exclude
        domain="file"
        path="settings/hidden_files/" />
</full-backup-content>
