#!/bin/sh
P=${FFPREFIX}
mode=""
for a in "$@"; do
  case "$a" in
    --libs) mode=libs;; --cflags) mode=cflags;; --modversion) mode=ver;; --exists|--print-errors|--static|--short-errors) ;;
  esac
done
case "$mode" in
  libs) echo "-L$P/lib -lopus -lm";;
  cflags) echo "-I$P/include/opus";;
  ver) echo "1.5.2";;
esac
exit 0
